@@ -0,0 +1,250 @@
+"""Task 14 into the published Fig. 2 and Fig. 3 artifacts, as the newest default; the older results stay one click away.
+
+python scripts/build_t14_artifacts.py
+  in:  artifacts/fig2_src_t14.html, artifacts/fig3_src_t14.html   (the published pages this build starts from)
+       results/t14/artifact_data.json                             (scripts/t14_artifact_data.py)
+  out: artifacts/fig2_v32.html, artifacts/fig3_v32.html
+
+Both figures default to the same design and parameters: 10 mm 24-facet circle CMPC, 8 inclusions r 25 um |dn| 0.01,
+output facet 11, grating-coupler input (75 um waist, +-60 mrad, +-100 um), wavelength dither +-81 pm (3.3 um), whole-membrane
+thermo-optic modulation delta n_eff 1e-4, synchronous averaging, set B at 3.3 um (n_eff 1.425, Gamma 0.553), R 97 %
+(R 99.5 % as the second case), 0.3 dB/cm, eps 1e-6, 30 layouts. Fig. 2 (f): static fringe bars of that design (CMPC only:
+the Herriott cell has no wave-model run); Fig. 3 (b): the noise floor of the same runs.
+"""
+import json
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+ART = ROOT / "artifacts"
+T14 = json.load(open(ROOT / "results" / "t14" / "artifact_data.json"))
+SIZES = (5, 10, 15, 20)
+PARAMS = {
+    "task": "QUIET Task 14 (REPORT section 6i), wave-consistent Gaussian-beamlet model",
+    "cell": "24-facet circle CMPC, diameter per data set, 8 inclusions r 25 um |dn| 0.01 (seeds 1-30), input facet 0, output facet 11, port 150 um",
+    "input_dither": "grating coupler: 75 um waist, +-60 mrad angle and +-100 um position, sine, >= 1 kHz",
+    "wavelength_dither": "triangle, +-81 pm at 3.3 um (+-2.2 GHz), +-35 pm at 1.53 um",
+    "membrane_modulation": "thermo-optic, whole membrane, delta n_eff 1e-4 (about +-9 K at 3.3 um), sine 50 Hz",
+    "averaging": "synchronous over whole dither / modulation periods; fringe drift 0.1 rad/s",
+    "material": "set B: 1000 nm SiNx at 3.3 um (n_eff 1.4253, Gamma 0.5526), 500 nm at 1.53 um (n_eff 1.5391, Gamma 0.4532); R 97 % and 99.5 %; 0.3 dB/cm",
+    "eps": 1e-6, "layouts": 30, "detector": "simulated transmission + 8 dB couplers, NEP 14 pW/rtHz, 10 mW",
+    "provenance": {k: {"script": v["script"], "args": v["args"], "generated_utc": v["generated_utc"], "engine_sha1": v["engine"]["sha1"]} for k, v in T14["meta"].items()},
+}
+DESC = ("Newest (QUIET Task 14): {D} mm 24-facet circle CMPC with the grating-coupler input (75 µm waist, ±60 mrad angle and ±100 µm position "
+        "dither), 8 inclusions r 25 µm |Δn| 0.01, output on facet 11, wavelength dither ±81 pm at 3.3 µm (±35 pm at 1.53 µm), and thermo-optic "
+        "modulation of the whole membrane (δn_eff 1e-4, ≈ ±9 K, 50 Hz) — it scrambles the fringe phases like a deep wavelength dither while the laser line "
+        "stays fixed. Averaging over whole dither and modulation periods (the AC parts vanish once a period is complete), fringe drift 0.1 rad/s. "
+        "Set B, 0.3 dB/cm, ε = 10⁻⁶; solid R 97 %, dash-dot R 99.5 %; medians and min–max bands over 30 layouts. “angle” = the input angle + position "
+        "dither, “both” = input + wavelength + membrane modulation. Detector: simulated transmission + 8 dB couplers, NEP 14 pW/√Hz, 10 mW. "
+        "Exit-path lists for the noise traces of (a) from the Task 11 run of the same cell.")
+
+
+def rep(s, a, b, cnt=1):
+    assert s.count(a) == cnt, (s.count(a), a[:100])
+    return s.replace(a, b)
+
+
+def json_block(s, sid):
+    m = re.search(rf'(<script id="{sid}" type="application/json">)(.*?)(</script>)', s, re.S)
+    return m, json.loads(m.group(2))
+
+
+# ---------------------------------------------------------------- Fig. 3
+def fig3(s):
+    m, ds = json_block(s, "dsets")
+    for D in SIZES:
+        c = f"d{D}"
+        sl = lambda band, R: {"cur": T14["cells"][f"{band}_R{R}_{c}"]["cur"], "reg": T14["cells"][f"{band}_R{R}_{c}"]["reg"]}
+        ds[f"T{D}"] = {
+            "label": f"newest: grating design + membrane modulation, {D} mm (Task 14)", "n_eff": 1.5391, "n_eff_mir": 1.4253,
+            "noise": {"model": "det", "IL": "sim", "P": 10}, "T": 15, "win": True, "smear": {"NH3": 0.804, "CH4": 0.921, "C2H6": 0.824},
+            "names": {"current": f"R 97 %, {D} mm (solid)", "target": f"R 99.5 %, {D} mm (dash-dot)"}, "short": {"target": "R 99.5 %"},
+            "modeNames": {"long": {"angle": "input dither (angle + position)", "both": "input + λ + membrane modulation"},
+                          "short": {"angle": "input", "both": "all dithers"}},
+            "desc": DESC.format(D=D), "params": dict(PARAMS, cell_diameter_mm=D),
+            "data": {"current": sl("nir", 0.97), "target": sl("nir", 0.995), "mir": sl("mir", 0.97), "mir_t": sl("mir", 0.995),
+                     "circle": {"c_radius": D * 0.5e-3, "n_facets": 24, "c_theta": 0.1308996938995747, "n_inc": 8, "inc_radius": 25e-6, "inc_dn": 0.01,
+                                "n_seeds": 30, "output_facet": 11, "membrane_dn_eff": 1e-4}}}
+    order = {f"T{D}": ds[f"T{D}"] for D in SIZES}
+    order.update({k: v for k, v in ds.items() if not k.startswith("T")})
+    s = s[:m.start(2)] + json.dumps(order, ensure_ascii=False) + s[m.end(2):]
+    # data-set menu: newest first and default
+    s = rep(s, '<option value="G10" selected>', '<option value="G10">')
+    i = s.index('<select id="dset3">') + len('<select id="dset3">')
+    s = s[:i] + "".join(f'<option value="T{D}"{" selected" if D == 10 else ""}>newest: grating design + membrane modulation, {D} mm (Task 14)</option>' for D in SIZES) + s[i:]
+    s = s.replace('<option value="B03">v32 set B: 500 nm SiNx, 1.53 µm, 0.3 dB/cm (default)</option>', '<option value="B03">v32 set B: 500 nm SiNx, 1.53 µm, 0.3 dB/cm</option>')
+    # results-version buttons and size buttons that keep the version
+    m2 = re.search(r'        <div class="btns" id="gcBtns3">.*?</div>\n', s)
+    s = s[:m2.start()] + (
+        '        <div class="btns" id="verBtns3"><span class="sel">results</span>'
+        '<button type="button" data-ver="T" aria-pressed="true" title="Task 14: grating-coupler input + membrane modulation, synchronous averaging">newest (Task 14)</button>'
+        '<button type="button" data-ver="G" aria-pressed="false" title="Task 11: grating-coupler input, boxcar averaging, no membrane modulation">Task 11</button>'
+        '<button type="button" data-ver="B03" aria-pressed="false" title="v32 set B ensembles, 4 mm cell, ±2 mrad launch (ray optics)">set B, 4 mm</button>'
+        '<button type="button" data-ver="S10" aria-pressed="false">step 10</button>'
+        '<button type="button" data-ver="A" aria-pressed="false">published (set A)</button></div>\n'
+        '        <div class="btns" id="gcBtns3"><span class="sel">design cell</span>'
+        + "".join(f'<button type="button" data-size="{D}" aria-pressed="{str(D == 10).lower()}">{D} mm</button>' for D in SIZES) + '</div>\n') + s[m2.end():]
+    s = rep(s, '#gcBtns3 button[aria-pressed="true"], #spBtns button[aria-pressed="true"] {', '#verBtns3 button[aria-pressed="true"], #gcBtns3 button[aria-pressed="true"], #spBtns button[aria-pressed="true"] {')
+    s = rep(s, '  const syncGc3 = () => document.querySelectorAll("#gcBtns3 button").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.ds === $("dset3").value)));\n',
+            '  /* results version (newest Task 14, Task 11, older ensembles) and cell size: the size buttons keep the version */\n'
+            '  const fam3 = () => { const v = $("dset3").value; return /^[TG]\\d/.test(v) ? v[0] : v; }, size3 = () => { const m = $("dset3").value.match(/^[TG](\\d+)$/); return m ? m[1] : null; };\n'
+            '  let lastSize3 = "10";\n'
+            '  const syncGc3 = () => { const f = fam3(), z = size3(); if (z) lastSize3 = z;\n'
+            '    document.querySelectorAll("#verBtns3 button").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.ver === f)));\n'
+            '    document.querySelectorAll("#gcBtns3 button").forEach(b => { b.setAttribute("aria-pressed", String(b.dataset.size === z)); b.disabled = !z; }); };\n')
+    s = rep(s, '  document.querySelectorAll("#gcBtns3 button").forEach(b => b.addEventListener("click", () => { $("dset3").value = b.dataset.ds; $("dset3").dispatchEvent(new Event("change")); }));',
+            '  const goDS3 = v => { $("dset3").value = v; $("dset3").dispatchEvent(new Event("change")); };\n'
+            '  document.querySelectorAll("#verBtns3 button").forEach(b => b.addEventListener("click", () => goDS3(b.dataset.ver === "T" || b.dataset.ver === "G" ? b.dataset.ver + lastSize3 : b.dataset.ver)));\n'
+            '  document.querySelectorAll("#gcBtns3 button").forEach(b => b.addEventListener("click", () => { const f = fam3(); goDS3((f === "T" || f === "G" ? f : "T") + b.dataset.size); }));\n'
+            '  syncGc3();')
+    # per-data-set names of the curves (the newest set: "angle" = input dither, "both" = all three)
+    s = rep(s, '  const MODE_SHORT = { none: "no dithering", angle: "angle", spectral: "wavelength", both: "both dithers" };\n',
+            '  const MODE_SHORT = { none: "no dithering", angle: "angle", spectral: "wavelength", both: "both dithers" };\n'
+            '  const MODE_NAME0 = Object.assign({}, MODE_NAME), MODE_SHORT0 = Object.assign({}, MODE_SHORT);\n')
+    s = rep(s, '    DSX = DS3[k]; const x = DSX.data;\n',
+            '    DSX = DS3[k]; const x = DSX.data;\n'
+            '    Object.assign(MODE_NAME, MODE_NAME0, (DSX.modeNames || {}).long || {}); Object.assign(MODE_SHORT, MODE_SHORT0, (DSX.modeNames || {}).short || {});\n')
+    s = rep(s, '    const L = { lossy: (DSX.names.lossy || "dashed case") ,',
+            '    const L = { angle: MODE_NAME.angle, both: MODE_NAME.both, lossy: (DSX.names.lossy || "dashed case") ,')
+    s = rep(s, 'data_set: { key: $("dset3").value, label: DSX.label }', 'data_set: { key: $("dset3").value, label: DSX.label, description: DSX.desc, parameters: DSX.params || null }')
+    s = rep(s, 'SPK === "NH3" ? 2.5 : 4, "angle", "#2ca02c"],', 'SPK === "NH3" ? 2.5 : 4, MODE_SHORT.angle, "#2ca02c"],')
+    s = rep(s, '["total", 3.6, 2.0, "both", "#000"]];', '["total", 3.6, 2.0, DSX.modeNames ? "all" : "both", "#000"]];')
+    s = rep(s, '<h1>Fig. 3 spectra and noise: v32 realistic parameters, earlier data for comparison</h1>',
+            '<h1>Fig. 3 spectra and noise: newest results (Task 14) by default, earlier results one click away</h1>')
+    return s
+
+
+# ---------------------------------------------------------------- Fig. 2
+BARS14 = r'''
+  /* ---------------------------------------------------------------- newest bars (f): Task 14 grating-coupler design, CMPC */
+  var T14D = null;
+  const CATS14 = [["none", "none"], ["spectral", "λ"], ["input", "input"], ["both", "input+λ"], ["all", "+δn"]];
+  const gcCur = () => { const b = document.querySelector('#gcSize button[aria-pressed="true"]'); return b ? b.dataset.gc : "d10"; };
+  function barsT14(x, y, w, h) {
+    if (!T14D) T14D = JSON.parse($("t14data").textContent);
+    const cs = (T14D.cases[$("gcCase").value] || {})[gcCur()], f = Math.sqrt(eps() / 1e-6), lfs = FSZ, KEY = 9;
+    rect(x, y, w, h, { stroke: "#000", sw: LW });
+    if (!cs) { waitNote(x, y, w, h, "no Task 14 data for this case"); return; }
+    const ser = [["reg", "R-CMPC", $("colCR").value], ["chaotic", "C-CMPC", $("colCC").value]];
+    const tgtOn = $("bTarget").checked, tgt = 10 ** +$("tgt").value;
+    const val = (k, s, p) => f * (s === "reg" ? cs.bars[k].reg : cs.bars[k].q[p]);
+    const vals = CATS14.flatMap(([k]) => [val(k, "reg"), val(k, "chaotic", 0), val(k, "chaotic", 2)]).concat(tgtOn ? [tgt] : []).filter(v => v > 0 && Number.isFinite(v));
+    let lx = x + w - 2;
+    const legW = ser.map(([, n]) => KEY + 4 + tw(n, lfs)), legX = [];
+    for (let i = ser.length - 1; i >= 0; i--) { lx -= legW[i]; legX[i] = lx; lx -= 8; }
+    ser.forEach(([, n, col], i) => { rect(legX[i], y + 2 + lfs * 0.2, KEY, lfs * 0.62, { fill: col }); text(legX[i] + KEY + 4, y + 2 + lfs * 0.8, n, { fs: lfs }); });
+    const legB = y + 2 + lfs * 1.05, xt = i => x + (i + 0.5) / CATS14.length * w;
+    CATS14.forEach(([, l], i) => { path([[xt(i), y + h], [xt(i), y + h + 3.5]], { stroke: "#000", sw: LW }); text(xt(i), y + h + FSZ * 1.3, l, { anchor: "middle" }); });
+    const lo = Math.min(...vals) / 3, top = y + 3, gw = w / CATS14.length * 0.62, bw = gw / ser.length;
+    let hi = Math.max(...vals) * 1.05;
+    const frac = (y + h - (legB + 1)) / (y + h - top);
+    CATS14.forEach(([k], i) => ser.forEach(([s], j) => { const bx = xt(i) - gw / 2 + j * bw, v = s === "reg" ? val(k, s) : val(k, s, 2);
+      if (bx + bw > legX[0] && v > lo && frac > 0.05) hi = Math.max(hi, 10 ** (Math.log10(lo) + (Math.log10(v) - Math.log10(lo)) / frac)); }));
+    const Y = v => y + h - (Math.log10(v) - Math.log10(lo)) / (Math.log10(hi) - Math.log10(lo)) * (y + h - top);
+    for (let p = Math.floor(Math.log10(lo)); p <= Math.log10(hi) + 1e-9; p++) {
+      const yy = Y(10 ** p);
+      if (10 ** p >= lo * (1 - 1e-9)) {
+        if ($("bGrid").checked && 10 ** p > lo * (1 + 1e-9)) path([[x, yy], [x + w, yy]], { stroke: "#000", so: 0.12, sw: 0.6 });
+        path([[x, yy], [x - 3.5, yy]], { stroke: "#000", sw: LW });
+        text(x - 5, yy + FSZ * 0.35, `10^{${p < 0 ? "−" + -p : p}}`, { anchor: "end" });
+      }
+      for (let m = 2; m < 10; m++) { const v = m * 10 ** p; if (v < lo || v > hi) continue; path([[x, Y(v)], [x - 2, Y(v)]], { stroke: "#000", sw: 0.6 }); }
+    }
+    CATS14.forEach(([k], i) => ser.forEach(([s, , col], j) => {
+      const bx = xt(i) - gw / 2 + j * bw, xc = bx + bw / 2, v = s === "reg" ? val(k, s) : val(k, s, 1);
+      if (!(v > 0)) return;
+      const by = Y(Math.max(v, lo));
+      rect(bx + 0.4, by, bw - 0.8, y + h - by, { fill: col });
+      let topY = by;
+      if (s !== "reg") { const yl = Y(Math.max(val(k, s, 0), lo)), yh = Y(val(k, s, 2)); topY = Math.min(by, yh);
+        path([[xc, yl], [xc, yh]], { stroke: "#000", sw: 0.8 }); path([[xc - 1.6, yl], [xc + 1.6, yl]], { stroke: "#000", sw: 0.8 }); path([[xc - 1.6, yh], [xc + 1.6, yh]], { stroke: "#000", sw: 0.8 }); }
+      if ($("bVals").checked) text(xc + FSZ * 0.25, topY - 2, sci(v, 2).replace(/e(-?\d+)/, (mm, ee) => `·10^{${ee.replace("-", "−")}}`), { rot: true, fs: FSZ * 0.7 });
+    }));
+    if (tgtOn && tgt >= lo && tgt <= hi) {
+      path([[x, Y(tgt)], [x + w, Y(tgt)]], { stroke: "#d62728", sw: 0.9, dash: [3, 2] });
+      text(x + w - 3, Y(tgt) - 3, "target", { anchor: "end", fill: "#d62728", fs: FSZ * 0.85 });
+    }
+  }
+'''
+
+
+def fig2(s):
+    cases = {}
+    for band in ("mir", "nir"):
+        for R in (0.97, 0.995):
+            k = f"{band}_R{R}"
+            cases[k] = {f"d{D}": {"bars": T14["cells"][f"{k}_d{D}"]["bars"], "N": T14["cells"][f"{k}_d{D}"]["N"], "T": T14["cells"][f"{k}_d{D}"]["cur"]["T_trans"],
+                                  "GL_cm": T14["cells"][f"{k}_d{D}"]["cur"]["gamma"] * T14["cells"][f"{k}_d{D}"]["cur"]["L_mean_m"] * 100} for D in SIZES}
+    blob = {"cases": cases, "params": PARAMS, "bars": {"none": "no dither", "spectral": "wavelength dither only", "input": "input angle + position dither only",
+                                                         "both": "input + wavelength", "membrane": "wavelength + membrane modulation", "all": "input + wavelength + membrane modulation"},
+            "values": "static fringe 2 sqrt(eps) V / sqrt(M) at eps 1e-6 (scaled with the eps slider), no drift; chaotic: 25 / 50 / 75 % over 30 layouts; regular: single value"}
+    s = rep(s, '<script id="ens" type="application/json">', '<script id="t14data" type="application/json">' + json.dumps(blob) + '</script>\n<script id="ens" type="application/json">')
+    m, ens = json_block(s, "ens")
+    ens = dict({"T14": {}}, **ens)
+    s = s[:m.start(2)] + json.dumps(ens) + s[m.end(2):]
+    m, dsm = json_block(s, "dsets")
