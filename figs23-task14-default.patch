+/* Provenance block written into every result file of the scripts that use it: how and with what the run was made, so
+   another session (or person) can read the parameters from the output alone. */
+const crypto = require('crypto');
+const fs = require('fs');
+const path = require('path');
+const { execSync } = require('child_process');
+const { ENGINE } = require('./engine_path.js');
+
+function runMeta(scriptFile, argv, params) {
+  let commit = null;
+  try { commit = execSync('git rev-parse HEAD', { cwd: path.dirname(scriptFile), stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch (e) { commit = null; }
+  return {
+    script: path.relative(path.join(__dirname, '..'), scriptFile), args: argv.join(' '), generated_utc: new Date().toISOString(), node: process.version,
+    git_commit_before_run: commit, engine: { file: path.relative(path.join(__dirname, '..'), ENGINE), sha1: crypto.createHash('sha1').update(fs.readFileSync(ENGINE)).digest('hex') },
+    units: 'SI unless the key says otherwise (m, rad, W); fringe values are the residual 2 sqrt(eps) V / sqrt(M) as a fraction of the detected power',
+    params: params,
+  };
+}
+module.exports = { runMeta };
