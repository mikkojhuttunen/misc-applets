+"""Task 14 artifact pack: the newest default data of the Fig. 2 (f) bars and the Fig. 3 (b) noise curves.
+
+python scripts/t14_artifact_data.py      -> results/t14/artifact_data.json
+
+Design (same in both figures): 24-facet circle CMPC, 5 / 10 / 15 / 20 mm, 8 inclusions r 25 um |dn| 0.01, input on facet 0,
+output on facet 11; large-area grating coupler, 75 um waist, +-60 mrad angle and +-100 um position dither (sine, >= 1 kHz);
+triangle wavelength dither +-81 pm at 3.3 um (+-35 pm at 1.53 um); thermo-optic modulation of the whole membrane,
+delta n_eff 1e-4 (about +-9 K at 3.3 um), 50 Hz; set B, 0.3 dB/cm, eps 1e-6; 30 layouts.
+Fig. 3 slots: none, "angle" = the input (angle + position) dither, spectral = the wavelength dither, both = input +
+wavelength + membrane modulation. Curves against the averaging time T, per layout:
+  r(T) = sqrt( (S Hd)^2 + (S_none^2 - S_a^2) W(T, 1 kHz) + (S_a^2 - S^2) W(T, 50 Hz) ),  Hd = 1 / sqrt(1 + 2 (0.05 T)^2)
+(drift 0.1 rad/s), S_a the fringe without the membrane modulation, W = 1 below one period and 0 above it: the averaging
+runs over whole dither / modulation periods (synchronous), so the AC parts vanish once a period is complete.
+Exit-path lists (for the noise traces of Fig. 3a) come from the Task 11 run of the same cell (results/t11/artifact_data.json).
+"""
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+from qv import analysis as A  # noqa: E402
+
+TG = A.load(ROOT / "data/baseline/fig3data.json")["T"]
+T11 = json.load(open(ROOT / "results/t11/artifact_data.json"))
+BEAM, MOD = "w75 A60 X100", "both+global 0.0001"
+GAMMA = {"nir": 0.4532, "mir": 0.5526}
+MODES = ("none", "angle", "spectral", "both")
+Hd = lambda T: 1 / math.sqrt(1 + 2 * (0.05 * T) ** 2)
+W = lambda T, f: 1.0 if T < 1 / f else 0.0
+
+
+def slot(F):
+    """the four Fig. 3 slots from one layout's fringe dict"""
+    return {"none": F["none"], "angle": F["input"], "spectral": F["spectral"], "both": F[MOD], "both_nomod": F["both"]}
+
+
+def curve(S, m, T):
+    n0 = S["none"]
+    if m == "none":
+        return n0 * Hd(T)
+    s = S[m]
+    a = S["both_nomod"] if m == "both" else s
+    return math.sqrt((s * Hd(T)) ** 2 + max(n0 ** 2 - a ** 2, 0) * W(T, 1000) + max(a ** 2 - s ** 2, 0) * W(T, 50))
+
+
+def q(v, p):
+    return float(np.quantile(v, p))
+
+
+out = {"T": TG, "design": {"beam": BEAM, "modulation": MOD.replace("both+", ""), "averaging": "synchronous (whole periods)", "drift_rad_s": 0.1}, "cells": {}, "meta": {}}
+for band in ("mir", "nir"):
+    for R in (0.97, 0.995):
+        f = ROOT / f"results/t14/{band}_R{R}.json"
+        d = json.load(open(f))
+        out["meta"][f"{band}_R{R}"] = d["meta"]
+        g = GAMMA[band]
+        for c, C in d["cells"].items():
+            rows = [x for x in C["chaotic"] if x.get("d", {}).get(BEAM)]
+            S = [slot(x["d"][BEAM]["fringe"]) for x in rows]
+            P = [x["d"][BEAM] for x in rows]
+            key = f"{band}_R{R}_{c}"
+            t11 = T11["cells"][key]["cur"]
+            curves = {m: np.array([[curve(s, m, T) for T in TG] for s in S]) for m in MODES}
+            cur = {"gamma": g, "L_mean_m": q([p["GL_cm"] for p in P], .5) / 100 / g, "T_trans": q([p["T"] for p in P], .5), "M2": q([p["M"] for p in P], .5),
+                   "Ls_m": t11["Ls_m"], "Ws": t11["Ws"],
+                   "env": {m: [float(np.median(curves[m][:, i])) for i in range(len(TG))] for m in MODES},
+                   "env_lo": {m: [float(curves[m][:, i].min()) for i in range(len(TG))] for m in MODES},
+                   "env_hi": {m: [float(curves[m][:, i].max()) for i in range(len(TG))] for m in MODES},
+                   "floor": {m: q([s[m] for s in S], .5) for m in MODES}, "R_bounce": R,
+                   "lay": {"fr": {str(T): [curve(s, "both", T) for s in S] for T in (0.01, 0.1, 0.5, 1, 15, 30, 60)},
+                           "none": {str(T): [curve(s, "none", T) for s in S] for T in (0.01, 0.1, 0.5, 1, 15, 30, 60)},
+                           "fl": [s["both"] for s in S], "fln": [s["none"] for s in S], "T": [p["T"] for p in P], "L": [p["GL_cm"] / 100 / g for p in P]}}
+            rg_ = C["regular"]["d"][BEAM]
+            rs = slot(rg_["fringe"])
+            reg = {"gamma": g, "L_mean_m": rg_["GL_cm"] / 100 / g, "T_trans": rg_["T"], "M2": rg_["M"], "Ls_m": cur["Ls_m"], "Ws": cur["Ws"],
+                   "env": {m: [curve(rs, m, T) for T in TG] for m in MODES}, "floor": {m: rs[m] for m in MODES}}
+            bars = {}
+            for name, k in (("none", "none"), ("spectral", "spectral"), ("input", "input"), ("both", "both"), ("membrane", "spectral+global 0.0001"), ("all", MOD)):
+                v = [x["d"][BEAM]["fringe"][k] for x in rows]
+                bars[name] = {"reg": rg_["fringe"][k], "q": [q(v, .25), q(v, .5), q(v, .75)]}
+            out["cells"][key] = {"cur": cur, "reg": reg, "bars": bars, "N": C["N"][BEAM], "dlam": d["dlam"]}
+A.dump(ROOT / "results/t14/artifact_data.json", out)
+print("cells", len(out["cells"]))
