+/* Task 14 for the Herriott cell: the same grating-coupler input, dithers and intracavity modulation as scripts/t14_waist_mod.js,
+   in Herriott cells of length 5 / 10 / 15 / 20 mm (width 1.5 mm, N 14, M 3, side walls, 8 inclusions r 25 um |dn| 0.01).
+
+   node scripts/t14_herriott.js --band mir|nir --R 0.97 --dBcm 0.3 --out results/t14/herriott_<band>_R<R>.json [--seeds 30] [--c_cal 1.378]
+
+   Input: the beam is launched from the M1 mirror wall around the port (as the circle cell's beam from its input facet);
+   launch points span the mirror from 10 um inside its ends, so the region is asymmetric about the port, which sits near the
+   mirror edge; the beam power that falls off the mirror counts as a loss (T includes the clip factor). Output: the same port
+   (the Herriott re-entrance hole, width meta.portW). Regular cell: no inclusions (re-entrant: neighbouring beamlets follow
+   one orbit, so the beamlet model is indicative only for it). Chaos check per layout: DitherLab.chaosMap (share of chaotic
+   launch rays, FTLE per hit). No "zone" modulation (it is defined for the circle).
+
+   1. Input waist: w 75 (Task 11 design) / 150 / 250 / 400 um with +-60 mrad angle and +-100 to +-200 um position dither
+      (sine). Launch positions are kept on the input facet: |x| <= XMAX = 0.45 x facet length (5 mm: 287 um ... 20 mm: 1149 um;
+      Task 11 used 250 um for every size); a beam is run only where w + Xa <= XMAX.
+   2. Intracavity modulation of the inclusions' index by delta (sine, incommensurate with the other dithers). First-order
+      (eikonal) model: every beamlet keeps its traced route; the modulation adds the phase k0 delta l_ij, l_ij the route's
+      geometric length inside the modulated spot i (the inclusion, r 25 um, or a 75 um heated spot at the same centre). Route
+      geometry changes are sub-diffraction (Task 5b) and left out. The time average of exp(i phi_j(t)) is exact:
+        independent heaters (one per inclusion, incommensurate rates)   mu_j = prod_i J0(k0 delta l_ij)
+        common modulation (one pump on all inclusions in phase)         mu_j = J0(k0 delta sum_i l_ij)
+        a heated zone, the central disk of half the cell area            mu_j = J0(k0 delta l_zone,j)
+        uniform heating of the whole membrane (for comparison)          mu_j = J0(k0 delta L_j)
+      and the static fringe of input + wavelength + intracavity dither is |sum_j cbar_j g_j sinc_j mu_j| (Task 9 normalisation).
+      delta = 1e-5 ... 3e-3; a SiNx slab mode has dn_eff/dT ~ 2e-5 /K, so delta 1e-3 is a local swing of ~ +-50 K.
+   Output per cell and layout: T, Gamma<L>, M (calibrated, as Task 10) and the fringe residual 2 sqrt(eps) V / sqrt(M)
+   (eps 1e-6) for none / input / spectral / both and the modulated variants, at the band's wavelength dither. */
+const fs = require('fs');
+const path = require('path');
+const { loadEngine } = require('./engine_path.js');
+const { config, args } = require('./cells.js');
+const { DitherLab: D, GasEngine: G, PlanarEngine: Pl } = loadEngine();
+const { runMeta } = require('./meta.js');
+const a = args(process.argv.slice(2));
+const band = a.band || 'mir', R = +(a.R || 0.97), dBcm = +(a.dBcm || 0.3), nSeed = +(a.seeds || 30), sigma = 10e-6;
+const B = band === 'nir' ? { lam: 1.5317e-6, n: 1.5391, gamma: 0.4532, dlam: 35e-12 } : { lam: 3.3151e-6, n: 1.4253, gamma: 0.5526, dlam: 81e-12 };
+const k0 = 2 * Math.PI / B.lam, kap = k0 * B.n, PORTW = 150e-6, NF = 24;
+const CELLS = [['h5', 5e-3], ['h10', 10e-3], ['h15', 15e-3], ['h20', 20e-3]].map(([name, L]) => ({ name, L, W: 1.5e-3, n_inc: 8, inc_r: 25e-6 }));
+const BEAMS = [['w75 A60 X100', 75e-6, 60e-3, 100e-6], ['w150 A60 X150', 150e-6, 60e-3, 150e-6], ['w250 A60 X150', 250e-6, 60e-3, 150e-6], ['w400 A60 X200', 400e-6, 60e-3, 200e-6]];
+const DELTAS = [1e-5, 3e-5, 1e-4, 3e-4, 1e-3, 3e-3], SPOTS = [25e-6, 75e-6], MODS = ['indep', 'common', 'global'];
+
+const sineS = n => Array.from({ length: n }, (_, i) => Math.sin(2 * Math.PI * (i + 0.5) / n));
