+const erf = x => { const t = 1 / (1 + 0.3275911 * Math.abs(x)), y = 1 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x); return x >= 0 ? y : -y; };
+/* power share of the beam (intensity exp(-2 x^2 / w^2), centre shifted by the sine position dither) on the mirror [a, b] */
+function clip(w, X, a, b) { let s = 0; const n = X > 0 ? 64 : 1; for (let i = 0; i < n; i++) { const c = X * Math.sin(2 * Math.PI * (i + 0.5) / n); s += 0.5 * (erf(Math.SQRT2 * (b - c) / w) - erf(Math.SQRT2 * (a - c) / w)); } return s / n; }
+function coefficients(L, w, A, X) {
+  const sA = sineS(nAng(A, w)), sX = sineS(nPos(X, w)), c0 = [], cb = [], n = sA.length * sX.length;
+  for (const xj of L.xs) for (const pj of L.phis) {
+    c0.push(coef(xj, pj, w, 0, 0));
+    let cr = 0, ci = 0;
+    for (const u of sA) for (const v of sX) { const c = coef(xj, pj, w, X * v, A * u); cr += c[0]; ci += c[1]; }
+    cb.push([cr / n, ci / n]);
+  }
+  let n0 = 0, nb = 0;
+  for (let j = 0; j < c0.length; j++) { n0 += c0[j][0] ** 2 + c0[j][1] ** 2; nb += cb[j][0] ** 2 + cb[j][1] ** 2; }
