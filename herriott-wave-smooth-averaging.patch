+function lattice(cell) {
+  const S0 = D.setup(opts(cell, 1)), c = S0.mc.cell, k1 = c.labels.indexOf('M1'), lo = c.s0[k1] - c.sIn + 10e-6, hi = c.s0[k1] + c.L[k1] - c.sIn - 10e-6;
+  const XMAX = Math.min(-lo, hi), XA = [lo, hi], r_ = Math.sqrt(Math.PI), dx = r_ * sigma, dphi = r_ / (2 * kap * sigma);
+  const PHIMAX = 60e-3 + 3 / (kap * 75e-6) + 3 / (2 * kap * sigma), xs = [], phis = [];
+  for (let x = Math.ceil(lo / dx) * dx; x <= hi + 1e-12; x += dx) xs.push(x);
+  for (let p = -Math.ceil(PHIMAX / dphi) * dphi; p <= PHIMAX + 1e-12; p += dphi) phis.push(p);
+  return { XMAX, XA, xs, phis, portW: c.meta.portW };
