+function J0(x) {                     /* Bessel J0 (Abramowitz & Stegun 9.4.1 / 9.4.3) */
+  const ax = Math.abs(x);
+  if (ax < 3) { const y = (x / 3) ** 2; return 1 + y * (-2.2499997 + y * (1.2656208 + y * (-0.3163866 + y * (0.0444479 + y * (-0.0039444 + y * 0.00021))))); }
