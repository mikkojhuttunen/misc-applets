{
 "shared": [
  "engines/__init__.py",
  "engines/common.py",
  "engines/registry.py"
 ],
 "engines": [
  {
   "engine": "bragg_grating",
   "version": 1,
   "title": "Bragg grating",
   "description": "Coupling coefficient, peak reflectance, bandwidth and exact stack reflectance of a Bragg grating.",
   "requires": [],
   "references": [
    "H. Kogelnik, in Guided-Wave Optoelectronics, ed. T. Tamir (Springer, 1988)",
    "M. Born and E. Wolf, Principles of Optics, §1.6 (characteristic matrices)"
   ],
   "files": [
    "engines/bragg_grating/__init__.py",
    "engines/bragg_grating/engine.py"
   ],
   "functions": {
    "coupling_coefficient": {
     "title": "Coupling coefficient κ",
     "equations": [
      "κ = 2 Δn sin(π m f) / (m λ)"
     ],
     "inputs": [
      {
       "name": "delta_n",
       "label": "Index contrast Δn",
       "ui_unit": "",
       "scale": 1.0,
       "default": 0.0177,
       "min": 0
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 100
      },
      {
       "name": "fill_factor",
       "label": "Filling ratio f",
       "ui_unit": "",
       "scale": 1.0,
       "default": 0.5,
       "min": 0,
       "max": 1
      },
      {
       "name": "order",
       "label": "Bragg order m",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1,
       "min": 1,
       "step": 1
      }
     ],
     "outputs": [
      {
       "name": "kappa",
       "label": "Coupling coefficient κ",
       "ui_unit": "1/cm",
       "scale": 100.0
      }
     ]
    },
    "grating_summary": {
     "title": "Peak reflectance and bandwidth",
     "equations": [
      "R = tanh^2(κL)",
      "Δλ_null = λ^2 / (π n_g L) sqrt((κL)^2 + π^2)",
      "L_eff = tanh(κL) / (2κ)"
     ],
     "inputs": [
      {
       "name": "kappa",
       "label": "Coupling coefficient κ",
       "ui_unit": "1/cm",
       "scale": 100.0,
       "default": 229
      },
      {
       "name": "length",
       "label": "Grating length L",
       "ui_unit": "µm",
       "scale": 1e-06,
       "default": 307
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 100
      },
      {
       "name": "n_group",
       "label": "Group index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.33,
       "min": 1
      }
     ],
     "outputs": [
      {
       "name": "R_peak",
       "label": "Peak reflectance",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "bandwidth_null",
       "label": "Null-to-null bandwidth",
       "ui_unit": "nm",
       "scale": 1e-09
      },
      {
       "name": "L_eff",
       "label": "Effective length",
       "ui_unit": "µm",
       "scale": 1e-06
      },
      {
       "name": "kappa_L",
       "label": "κL",
       "ui_unit": "",
       "scale": 1.0
      }
     ]
    },
    "stack_reflectance": {
     "title": "Quarter-wave or arbitrary periodic stack",
     "equations": [
      "[E0, H0] = (M_H M_L)^N [Es, Hs]",
      "M = [[cos δ, -i sin δ / n], [-i n sin δ, cos δ]]"
     ],
     "inputs": [
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 100
      },
      {
       "name": "n_high",
       "label": "High index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.0272,
       "min": 1
      },
      {
       "name": "n_low",
       "label": "Low index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.0095,
       "min": 1
      },
      {
       "name": "d_high",
       "label": "High-index layer thickness",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 191.2
      },
      {
       "name": "d_low",
       "label": "Low-index layer thickness",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 192.8
      },
      {
       "name": "periods",
       "label": "Periods N",
       "ui_unit": "",
       "scale": 1.0,
       "default": 800,
       "min": 1,
       "step": 1
      }
     ],
     "outputs": [
      {
       "name": "R",
       "label": "Reflectance",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "T",
       "label": "Transmittance",
       "ui_unit": "",
       "scale": 1.0
      }
     ]
    }
   }
  },
  {
   "engine": "gaussian_beam",
   "version": 1,
   "title": "Gaussian beam",
   "description": "TEM00 beam radius, curvature, Gouy phase, Rayleigh range and thin-lens focusing.",
   "requires": [],
   "references": [
    "A. E. Siegman, Lasers (University Science Books, 1986), ch. 17 and 20"
   ],
   "files": [
    "engines/gaussian_beam/__init__.py",
    "engines/gaussian_beam/engine.py"
   ],
   "functions": {
    "beam_parameters": {
     "title": "Rayleigh range and divergence",
     "equations": [
      "z_R = pi w0^2 n / (M2 lambda)",
      "theta = M2 lambda / (pi n w0)"
     ],
     "inputs": [
      {
       "name": "w0",
       "label": "Waist radius w0",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 1.0,
       "min": 0.0001
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 633,
       "min": 1
      },
      {
       "name": "n",
       "label": "Refractive index n",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 1.0
      },
      {
       "name": "M2",
       "label": "Beam quality M²",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 1.0
      }
     ],
     "outputs": [
      {
       "name": "z_R",
       "label": "Rayleigh range",
       "ui_unit": "m",
       "scale": 1.0
      },
      {
       "name": "theta",
       "label": "Divergence half-angle",
       "ui_unit": "mrad",
       "scale": 0.001
      },
      {
       "name": "b",
       "label": "Confocal parameter",
       "ui_unit": "m",
       "scale": 1.0
      }
     ]
    },
    "beam_at": {
     "title": "Beam at a position z",
     "equations": [
      "w(z) = w0 sqrt(1 + ((z - z0)/z_R)^2)",
      "R(z) = (z - z0) (1 + (z_R/(z - z0))^2)"
     ],
     "inputs": [
      {
       "name": "z",
       "label": "Position z",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 1000
      },
      {
       "name": "w0",
       "label": "Waist radius w0",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 1.0,
       "min": 0.0001
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 633,
       "min": 1
      },
      {
       "name": "z0",
       "label": "Waist position z0",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 0
      },
      {
       "name": "n",
       "label": "Refractive index n",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 1.0
      },
      {
       "name": "M2",
       "label": "Beam quality M²",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 1.0
      }
     ],
     "outputs": [
      {
       "name": "w",
       "label": "Beam radius w(z)",
       "ui_unit": "mm",
       "scale": 0.001
      },
      {
       "name": "R",
       "label": "Wavefront radius R(z)",
       "ui_unit": "m",
       "scale": 1.0
      },
      {
       "name": "gouy_phase",
       "label": "Gouy phase",
       "ui_unit": "rad",
       "scale": 1.0
      },
      {
       "name": "z_R",
       "label": "Rayleigh range",
       "ui_unit": "m",
       "scale": 1.0
      }
     ]
    },
    "thin_lens_focus": {
     "title": "Focusing by a thin lens",
     "equations": [
      "q' = (A q + B) / (C q + D)"
     ],
     "inputs": [
      {
       "name": "w0",
       "label": "Waist radius w0",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 1.0,
       "min": 0.0001
      },
      {
       "name": "s",
       "label": "Waist-to-lens distance",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 500
      },
      {
       "name": "f",
       "label": "Focal length",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 100
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 633,
       "min": 1
      },
      {
       "name": "n",
       "label": "Refractive index n",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 1.0
      }
     ],
     "outputs": [
      {
       "name": "w0_out",
       "label": "Output waist",
       "ui_unit": "µm",
       "scale": 1e-06
      },
      {
       "name": "z_out",
       "label": "Output waist after lens",
       "ui_unit": "mm",
       "scale": 0.001
      },
      {
       "name": "w_at_lens",
       "label": "Beam radius at the lens",
       "ui_unit": "mm",
       "scale": 0.001
      }
     ]
    }
   }
  },
  {
   "engine": "materials",
   "version": 1,
   "title": "Material refractive index",
   "description": "Sellmeier phase and group index of SiO2, Si3N4, LiNbO3 (e, o), LiTaO3 (approximate) and Si.",
   "requires": [],
   "references": [
    "I. H. Malitson, JOSA 55, 1205 (1965)",
    "D. E. Zelmon, D. L. Small, D. Jundt, JOSA B 14, 3319 (1997)",
    "K. Luke et al., Opt. Lett. 40, 4823 (2015)"
   ],
   "files": [
    "engines/materials/__init__.py",
    "engines/materials/engine.py"
   ],
   "functions": {
    "refractive_index": {
     "title": "Phase and group index",
     "equations": [
      "n^2 = 1 + sum_i A_i λ^2 / (λ^2 - B_i)",
      "n_g = n - λ dn/dλ"
     ],
     "inputs": [
      {
       "name": "material",
       "label": "Material",
       "type": "choice",
       "choices": [
        "sio2",
        "si3n4",
        "ln_e",
        "ln_o",
        "lt_e",
        "si"
       ],
       "default": "sio2"
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 200
      }
     ],
     "outputs": [
      {
       "name": "n",
       "label": "Phase index n",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "n_group",
       "label": "Group index n_g",
       "ui_unit": "",
       "scale": 1.0
      }
     ]
    }
   }
  },
  {
   "engine": "parametric_amplifier",
   "version": 1,
   "title": "Fiber parametric amplifier",
   "description": "chi2 three-wave and chi3 four-wave optical parametric amplification with pump depletion, idler loss engineering and gain bandwidth.",
   "requires": [],
   "references": [
    "R. W. Boyd, Nonlinear Optics, 3rd ed., sec. 2.9 (parametric amplification)",
    "G. P. Agrawal, Nonlinear Fiber Optics, ch. 10 (four-wave mixing)",
    "J. Ma et al., Quasi-parametric amplification of chirped pulses based on a Sm3+-doped yttrium calcium oxyborate crystal, Optica 2, 1006 (2015)"
   ],
   "files": [
    "engines/parametric_amplifier/__init__.py",
    "engines/parametric_amplifier/engine.py",
    "engines/stimulated_scattering/__init__.py",
    "engines/stimulated_scattering/engine.py"
   ],
   "functions": {
    "coupling": {
     "title": "Gain coefficient from the nonlinearity and mode sizes",
     "equations": [
      "chi2: Gamma = K sqrt(P_p / hbar w_p), K = 2 d sqrt(hbar w_p w_s w_i / (2 eps0 c^3 n^3)) Theta",
      "chi3: Gamma = gamma_p P_p sqrt(w_s w_i) / w_p, gamma_p = n2 w_p / (c A_eff)"
     ],
     "inputs": [
      {
       "name": "process",
       "label": "Process",
       "type": "choice",
       "choices": [
        "chi2",
        "chi3"
       ],
       "default": "chi2"
      },
      {
       "name": "lambda_pump",
       "label": "Pump wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 532,
       "min": 300,
       "max": 2500
      },
      {
       "name": "lambda_signal",
       "label": "Signal wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 400,
       "max": 3000
      },
      {
       "name": "w_pump",
       "label": "Pump mode radius",
       "ui_unit": "µm",
       "scale": 1e-06,
       "default": 2.5,
       "min": 0.5,
       "max": 100
      },
      {
       "name": "w_signal",
       "label": "Signal mode radius",
       "ui_unit": "µm",
       "scale": 1e-06,
       "default": 5.0,
       "min": 0.5,
       "max": 100
      },
      {
       "name": "w_idler",
       "label": "Idler mode radius",
       "ui_unit": "µm",
       "scale": 1e-06,
       "default": 3.18,
       "min": 0.5,
       "max": 100
      },
      {
       "name": "pump_power",
       "label": "Pump power",
       "ui_unit": "W",
       "scale": 1.0,
       "default": 1.0,
       "min": 0.0001,
       "max": 1000
      },
      {
       "name": "d_eff",
       "label": "d_eff (chi2)",
       "ui_unit": "pm/V",
       "scale": 1e-12,
       "default": 0.08,
       "min": 0.001,
       "max": 100
      },
      {
       "name": "n2",
       "label": "n2 (chi3)",
       "ui_unit": "1e-20 m²/W",
       "scale": 1e-20,
       "default": 2.6,
       "min": 0.1,
       "max": 10000
      }
     ],
     "outputs": [
      {
       "name": "gain_coefficient",
       "label": "Gain coefficient Γ",
       "ui_unit": "1/m",
       "scale": 1.0
      },
      {
       "name": "A_eff",
       "label": "Effective area",
       "ui_unit": "µm²",
       "scale": 1e-12
      },
      {
       "name": "lambda_idler",
       "label": "Idler wavelength",
       "ui_unit": "nm",
       "scale": 1e-09
      },
      {
       "name": "gamma",
       "label": "γ at the pump (chi3)",
       "ui_unit": "1/(W km)",
       "scale": 0.001
      },
      {
       "name": "nonlinear_phase",
       "label": "2γP (chi3)",
       "ui_unit": "rad/m",
       "scale": 1.0
      }
     ]
    },
    "small_signal_gain": {
     "title": "Undepleted-pump signal gain",
     "equations": [
      "d/dz [s, c] = [[-a_s/2, i Gamma], [-i Gamma, i dk - a_i/2]] [s, c]",
      "G = 1 + (Gamma/g)^2 sinh^2(g L) without loss"
     ],
     "inputs": [
      {
       "name": "gain_coefficient",
       "label": "Gain coefficient Γ",
       "ui_unit": "1/m",
       "scale": 1.0,
       "default": 0.95,
       "min": 0,
       "max": 1000
      },
      {
       "name": "phase_mismatch",
       "label": "Phase mismatch Δk (chi2) or κ (chi3)",
       "ui_unit": "rad/m",
       "scale": 1.0,
       "default": 0,
       "min": -1000,
       "max": 1000
      },
      {
       "name": "length",
       "label": "Fiber length",
       "ui_unit": "m",
       "scale": 1.0,
       "default": 5.0,
       "min": 0.01,
       "max": 1000
      },
      {
       "name": "idler_loss",
       "label": "Idler loss α_i",
       "ui_unit": "1/m",
       "scale": 1.0,
       "default": 0,
       "min": 0,
       "max": 1000
      },
      {
       "name": "signal_loss",
       "label": "Signal loss α_s",
       "ui_unit": "1/m",
       "scale": 1.0,
       "default": 0,
       "min": 0,
       "max": 1000
      },
      {
       "name": "n_dumps",
       "label": "Number of idler dumps",
       "ui_unit": "",
       "scale": 1.0,
       "default": 0,
       "min": 0,
       "max": 1000,
       "step": 1
      },
      {
       "name": "idler_dump_transmission",
       "label": "Idler transmission per dump",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 0,
       "max": 1
      }
     ],
     "outputs": [
      {
       "name": "gain_db",
       "label": "Signal gain",
       "ui_unit": "dB",
       "scale": 1.0
      },
      {
       "name": "gain",
       "label": "Signal gain (linear)",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "idler_conversion",
       "label": "Idler photons out / signal photons in",
       "ui_unit": "",
       "scale": 1.0
      }
     ]
    },
    "amplify": {
     "title": "Full coupled-wave solution (pump depletion)",
     "equations": [
      "RK4 integration of the three coupled amplitude equations"
     ],
     "inputs": [
      {
       "name": "process",
       "label": "Process",
       "type": "choice",
       "choices": [
        "chi2",
        "chi3"
       ],
       "default": "chi2"
      },
      {
       "name": "lambda_pump",
       "label": "Pump wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 532,
       "min": 300,
       "max": 2500
      },
      {
       "name": "lambda_signal",
       "label": "Signal wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 400,
       "max": 3000
      },
      {
       "name": "pump_power",
       "label": "Pump power",
       "ui_unit": "W",
       "scale": 1.0,
       "default": 1.0,
       "min": 0.0001,
       "max": 1000
      },
      {
       "name": "signal_power",
       "label": "Signal input power",
       "ui_unit": "mW",
       "scale": 0.001,
       "default": 0.01,
       "min": 1e-09,
       "max": 10000
      },
      {
       "name": "length",
       "label": "Fiber length",
       "ui_unit": "m",
       "scale": 1.0,
       "default": 5.0,
       "min": 0.01,
       "max": 1000
      },
      {
       "name": "gain_coefficient",
       "label": "Gain coefficient Γ",
       "ui_unit": "1/m",
       "scale": 1.0,
       "default": 0.95,
       "min": 0,
       "max": 1000
      },
      {
       "name": "phase_mismatch",
       "label": "Phase mismatch Δk (chi2) or κ (chi3)",
       "ui_unit": "rad/m",
       "scale": 1.0,
       "default": 0,
       "min": -1000,
       "max": 1000
      },
      {
       "name": "idler_loss",
       "label": "Idler loss α_i",
       "ui_unit": "1/m",
       "scale": 1.0,
       "default": 0,
       "min": 0,
       "max": 1000
      }
     ],
     "outputs": [
      {
       "name": "gain_db",
       "label": "Signal gain",
       "ui_unit": "dB",
       "scale": 1.0
      },
      {
       "name": "P_signal_out",
       "label": "Signal output",
       "ui_unit": "mW",
       "scale": 0.001
      },
      {
       "name": "P_idler_out",
       "label": "Idler output",
       "ui_unit": "mW",
       "scale": 0.001
      },
      {
       "name": "P_pump_out",
       "label": "Pump output",
       "ui_unit": "W",
       "scale": 1.0
      },
      {
       "name": "pump_depletion",
       "label": "Pump depletion",
       "ui_unit": "%",
