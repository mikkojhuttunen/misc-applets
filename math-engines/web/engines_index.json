      {
       "name": "photon_residual",
       "label": "Photon-number check",
       "ui_unit": "",
       "scale": 1.0
      }
     ]
    },
    "gain_bandwidth": {
     "title": "Gain bandwidth in nm and GHz",
     "equations": [
      "dk(Omega) = dk0 + s (GVM Omega - (beta2_s + beta2_i) Omega^2 / 2)",
      "Delta-lambda = lambda^2 Delta-nu / c"
     ],
     "inputs": [
      {
       "name": "gain_coefficient",
       "label": "Gain coefficient Γ",
       "ui_unit": "1/m",
       "scale": 1.0,
       "default": 0.95,
       "min": 0,
       "max": 1000
      },
      {
       "name": "length",
       "label": "Fiber length",
       "ui_unit": "m",
       "scale": 1.0,
