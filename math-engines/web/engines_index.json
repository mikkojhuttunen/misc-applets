{
 "engines": [
  {
   "description": "Fused-silica index, the scalar LP01 mode of a step-index fiber and the three-/four-wave phase mismatch it produces.",
   "engine": "fiber_mode",
   "functions": [
    {
     "equations": [
      "n^2 - 1 = sum_k B_k lambda^2 / (lambda^2 - C_k^2)"
     ],
     "inputs": [
      {
       "default": 1550,
       "label": "Vacuum wavelength",
       "max": 3700,
       "min": 210,
       "name": "wavelength",
       "scale": 1e-09,
       "ui_unit": "nm"
      }
     ],
     "name": "silica_index",
     "outputs": [
      {
       "label": "Refractive index",
       "name": "n",
       "scale": 1.0,
       "ui_unit": "1"
      }
     ],
     "title": "Fused-silica refractive index"
    },
    {
     "equations": [
      "U J1(U)/J0(U) = W K1(W)/K0(W), U^2 + W^2 = V^2",
      "w/a = 0.65 + 1.619 V^-3/2 + 2.879 V^-6"
     ],
     "inputs": [
      {
       "default": 1550,
       "label": "Vacuum wavelength",
       "max": 3700,
       "min": 210,
       "name": "wavelength",
       "scale": 1e-09,
       "ui_unit": "nm"
      },
      {
       "default": 4.1,
