        "al2o3",
        "er_al2o3"
       ],
       "default": "sio2"
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 200
      }
