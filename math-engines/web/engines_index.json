       "max": 50,
       "min": 0.5,
       "name": "core_radius",
       "scale": 1e-06,
       "ui_unit": "µm"
      },
      {
       "default": 0.005,
       "label": "Core index step Δn",
       "max": 0.05,
       "min": 0.0005,
       "name": "delta_n",
       "scale": 1.0,
       "ui_unit": "1"
      }
     ],
     "name": "lp01_mode",
     "outputs": [
      {
       "label": "Effective index",
       "name": "n_eff",
       "scale": 1.0,
       "ui_unit": "1"
      },
      {
       "label": "Normalised frequency V",
       "name": "V",
       "scale": 1.0,
       "ui_unit": "1"
      },
      {
       "label": "Normalised propagation constant b",
       "name": "b",
       "scale": 1.0,
       "ui_unit": "1"
      },
      {
       "label": "Mode radius (1/e² intensity)",
       "name": "w_mode",
       "scale": 1e-06,
       "ui_unit": "µm"
      }
     ],
     "title": "LP01 mode of a step-index fiber"
    },
    {
     "equations": [
      "chi2: dk = k_p - k_s - k_i",
      "chi3: dbeta = k_s + k_i - 2 k_p",
      "GVM = beta1_i - beta1_s"
     ],
     "inputs": [
      {
       "default": 1550,
       "label": "Signal wavelength",
       "max": 3000,
       "min": 400,
       "name": "lambda_signal",
       "scale": 1e-09,
       "ui_unit": "nm"
      },
      {
       "default": 532,
       "label": "Pump wavelength",
       "max": 2500,
       "min": 300,
       "name": "lambda_pump",
       "scale": 1e-09,
       "ui_unit": "nm"
      },
      {
       "default": 4.1,
       "label": "Core radius a",
       "max": 50,
       "min": 0.5,
       "name": "core_radius",
       "scale": 1e-06,
       "ui_unit": "µm"
      },
      {
       "default": 0.005,
       "label": "Core index step Δn",
       "max": 0.05,
       "min": 0.0005,
       "name": "delta_n",
       "scale": 1.0,
       "ui_unit": "1"
