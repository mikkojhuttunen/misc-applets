      },
      {
       "name": "lambda_signal",
       "label": "Signal wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 400,
       "max": 3000
      },
      {
       "name": "lambda_pump",
       "label": "Pump wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 532,
       "min": 300,
       "max": 2500
