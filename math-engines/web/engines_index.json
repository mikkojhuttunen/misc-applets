{
 "shared": [
  "engines/__init__.py",
  "engines/common.py",
  "engines/registry.py"
 ],
 "engines": [
  {
   "engine": "bragg_grating",
   "version": 1,
   "title": "Bragg grating",
   "description": "Coupling coefficient, peak reflectance, bandwidth and exact stack reflectance of a Bragg grating.",
   "requires": [],
   "references": [
    "H. Kogelnik, in Guided-Wave Optoelectronics, ed. T. Tamir (Springer, 1988)",
    "M. Born and E. Wolf, Principles of Optics, §1.6 (characteristic matrices)"
   ],
   "files": [
    "engines/bragg_grating/__init__.py",
    "engines/bragg_grating/engine.py"
   ],
   "functions": {
    "coupling_coefficient": {
     "title": "Coupling coefficient κ",
     "equations": [
      "κ = 2 Δn sin(π m f) / (m λ)"
     ],
     "inputs": [
      {
       "name": "delta_n",
       "label": "Index contrast Δn",
       "ui_unit": "",
       "scale": 1.0,
       "default": 0.0177,
       "min": 0
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 100
      },
      {
       "name": "fill_factor",
       "label": "Filling ratio f",
       "ui_unit": "",
       "scale": 1.0,
       "default": 0.5,
       "min": 0,
       "max": 1
      },
      {
       "name": "order",
       "label": "Bragg order m",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1,
       "min": 1,
       "step": 1
      }
     ],
     "outputs": [
      {
       "name": "kappa",
       "label": "Coupling coefficient κ",
       "ui_unit": "1/cm",
       "scale": 100.0
      }
     ]
    },
    "grating_summary": {
     "title": "Peak reflectance and bandwidth",
     "equations": [
      "R = tanh^2(κL)",
      "Δλ_null = λ^2 / (π n_g L) sqrt((κL)^2 + π^2)",
      "L_eff = tanh(κL) / (2κ)"
     ],
     "inputs": [
      {
       "name": "kappa",
       "label": "Coupling coefficient κ",
       "ui_unit": "1/cm",
       "scale": 100.0,
       "default": 229
      },
      {
       "name": "length",
       "label": "Grating length L",
       "ui_unit": "µm",
       "scale": 1e-06,
       "default": 307
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 100
      },
      {
       "name": "n_group",
       "label": "Group index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.33,
       "min": 1
      }
     ],
     "outputs": [
      {
       "name": "R_peak",
       "label": "Peak reflectance",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "bandwidth_null",
       "label": "Null-to-null bandwidth",
       "ui_unit": "nm",
       "scale": 1e-09
      },
      {
       "name": "L_eff",
       "label": "Effective length",
       "ui_unit": "µm",
       "scale": 1e-06
      },
      {
       "name": "kappa_L",
       "label": "κL",
       "ui_unit": "",
       "scale": 1.0
      }
     ]
    },
    "stack_reflectance": {
     "title": "Quarter-wave or arbitrary periodic stack",
     "equations": [
      "[E0, H0] = (M_H M_L)^N [Es, Hs]",
      "M = [[cos δ, -i sin δ / n], [-i n sin δ, cos δ]]"
     ],
     "inputs": [
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 100
      },
      {
       "name": "n_high",
       "label": "High index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.0272,
       "min": 1
      },
      {
       "name": "n_low",
       "label": "Low index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.0095,
       "min": 1
      },
      {
       "name": "d_high",
       "label": "High-index layer thickness",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 191.2
      },
      {
       "name": "d_low",
       "label": "Low-index layer thickness",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 192.8
      },
      {
       "name": "periods",
       "label": "Periods N",
       "ui_unit": "",
       "scale": 1.0,
       "default": 800,
       "min": 1,
       "step": 1
      }
     ],
     "outputs": [
      {
       "name": "R",
       "label": "Reflectance",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "T",
       "label": "Transmittance",
       "ui_unit": "",
       "scale": 1.0
      }
     ]
    }
   }
  },
  {
   "engine": "gaussian_beam",
   "version": 1,
   "title": "Gaussian beam",
   "description": "TEM00 beam radius, curvature, Gouy phase, Rayleigh range and thin-lens focusing.",
   "requires": [],
   "references": [
    "A. E. Siegman, Lasers (University Science Books, 1986), ch. 17 and 20"
   ],
   "files": [
    "engines/gaussian_beam/__init__.py",
    "engines/gaussian_beam/engine.py"
   ],
   "functions": {
    "beam_parameters": {
     "title": "Rayleigh range and divergence",
     "equations": [
      "z_R = pi w0^2 n / (M2 lambda)",
      "theta = M2 lambda / (pi n w0)"
     ],
     "inputs": [
      {
       "name": "w0",
       "label": "Waist radius w0",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 1.0,
       "min": 0.0001
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 633,
       "min": 1
      },
      {
       "name": "n",
       "label": "Refractive index n",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 1.0
      },
      {
       "name": "M2",
       "label": "Beam quality M²",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 1.0
      }
     ],
     "outputs": [
      {
       "name": "z_R",
       "label": "Rayleigh range",
       "ui_unit": "m",
       "scale": 1.0
      },
      {
       "name": "theta",
       "label": "Divergence half-angle",
       "ui_unit": "mrad",
       "scale": 0.001
      },
      {
       "name": "b",
       "label": "Confocal parameter",
       "ui_unit": "m",
       "scale": 1.0
      }
     ]
    },
    "beam_at": {
     "title": "Beam at a position z",
     "equations": [
      "w(z) = w0 sqrt(1 + ((z - z0)/z_R)^2)",
      "R(z) = (z - z0) (1 + (z_R/(z - z0))^2)"
     ],
     "inputs": [
      {
       "name": "z",
       "label": "Position z",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 1000
      },
      {
       "name": "w0",
       "label": "Waist radius w0",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 1.0,
       "min": 0.0001
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 633,
       "min": 1
      },
      {
       "name": "z0",
       "label": "Waist position z0",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 0
      },
      {
       "name": "n",
       "label": "Refractive index n",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 1.0
      },
      {
       "name": "M2",
       "label": "Beam quality M²",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 1.0
      }
     ],
     "outputs": [
      {
       "name": "w",
       "label": "Beam radius w(z)",
       "ui_unit": "mm",
       "scale": 0.001
      },
      {
       "name": "R",
       "label": "Wavefront radius R(z)",
       "ui_unit": "m",
       "scale": 1.0
      },
      {
       "name": "gouy_phase",
       "label": "Gouy phase",
       "ui_unit": "rad",
       "scale": 1.0
      },
      {
       "name": "z_R",
       "label": "Rayleigh range",
       "ui_unit": "m",
       "scale": 1.0
      }
     ]
    },
    "thin_lens_focus": {
     "title": "Focusing by a thin lens",
     "equations": [
      "q' = (A q + B) / (C q + D)"
     ],
     "inputs": [
      {
       "name": "w0",
       "label": "Waist radius w0",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 1.0,
       "min": 0.0001
      },
      {
       "name": "s",
       "label": "Waist-to-lens distance",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 500
      },
      {
       "name": "f",
       "label": "Focal length",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 100
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 633,
       "min": 1
      },
      {
       "name": "n",
       "label": "Refractive index n",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 1.0
      }
     ],
     "outputs": [
      {
       "name": "w0_out",
       "label": "Output waist",
       "ui_unit": "µm",
       "scale": 1e-06
      },
      {
       "name": "z_out",
       "label": "Output waist after lens",
       "ui_unit": "mm",
       "scale": 0.001
      },
      {
       "name": "w_at_lens",
       "label": "Beam radius at the lens",
       "ui_unit": "mm",
       "scale": 0.001
      }
     ]
    }
   }
  },
  {
   "engine": "materials",
   "version": 1,
   "title": "Material refractive index",
   "description": "Sellmeier phase and group index of SiO2, Si3N4, LiNbO3 (e, o), LiTaO3 (approximate) and Si.",
   "requires": [],
   "references": [
    "I. H. Malitson, JOSA 55, 1205 (1965)",
    "D. E. Zelmon, D. L. Small, D. Jundt, JOSA B 14, 3319 (1997)",
    "K. Luke et al., Opt. Lett. 40, 4823 (2015)"
   ],
   "files": [
    "engines/materials/__init__.py",
    "engines/materials/engine.py"
   ],
   "functions": {
    "refractive_index": {
     "title": "Phase and group index",
     "equations": [
      "n^2 = 1 + sum_i A_i λ^2 / (λ^2 - B_i)",
      "n_g = n - λ dn/dλ"
     ],
     "inputs": [
      {
       "name": "material",
       "label": "Material",
       "type": "choice",
       "choices": [
        "sio2",
        "si3n4",
        "ln_e",
        "ln_o",
        "lt_e",
        "si"
       ],
       "default": "sio2"
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 200
      }
     ],
     "outputs": [
      {
       "name": "n",
       "label": "Phase index n",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "n_group",
       "label": "Group index n_g",
       "ui_unit": "",
       "scale": 1.0
      }
     ]
    }
   }
  },
  {
   "engine": "phase_matching",
   "version": 1,
   "title": "Three-wave phase matching",
   "description": "Phase mismatch, QPM period of any order, coherence length and sinc² response for ω3 = ω1 + ω2 with arbitrary mode indices (bulk, birefringent or modal).",
   "requires": [],
   "references": [
    "M. M. Fejer, G. A. Magel, D. H. Jundt, R. L. Byer, IEEE J. Quantum Electron. 28, 2631 (1992)",
    "R. W. Boyd, Nonlinear Optics, 3rd ed. (Academic Press, 2008), ch. 2"
   ],
   "files": [
    "engines/phase_matching/__init__.py",
    "engines/phase_matching/engine.py"
   ],
   "functions": {
    "three_wave_mismatch": {
     "title": "Mismatch and required period",
     "equations": [
      "1/λ3 = 1/λ1 + 1/λ2",
      "Δk = 2π (n3/λ3 - n1/λ1 - n2/λ2) - 2π m / Λ",
      "Λ_req = m 2π / |Δk_bare|"
     ],
     "inputs": [
      {
       "name": "wavelength_1",
       "label": "Wave 1 vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 100
      },
      {
       "name": "wavelength_2",
       "label": "Wave 2 vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 100
      },
      {
       "name": "n_1",
       "label": "Wave 1 index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.0272,
       "min": 1
      },
      {
       "name": "n_2",
       "label": "Wave 2 index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.0272,
       "min": 1
      },
      {
       "name": "n_3",
       "label": "Wave 3 (sum) index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.1924,
       "min": 1
      },
      {
       "name": "order",
       "label": "QPM order m",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1,
       "min": 1,
       "step": 1
      }
     ],
     "outputs": [
      {
       "name": "wavelength_3",
       "label": "Wave 3 wavelength",
       "ui_unit": "nm",
       "scale": 1e-09
      },
      {
       "name": "delta_k_bare",
       "label": "Bare mismatch Δk",
       "ui_unit": "1/cm",
       "scale": 100.0
      },
      {
       "name": "period_required",
       "label": "Required grating period",
       "ui_unit": "µm",
       "scale": 1e-06
      },
      {
       "name": "coherence_length",
       "label": "Coherence length",
       "ui_unit": "µm",
       "scale": 1e-06
      }
     ]
    }
   }
  },
  {
   "engine": "qpm_shg",
   "version": 1,
   "title": "QPM second-harmonic generation",
   "description": "Phase mismatch, first-order poling period, coherence length and QPM bandwidth for SHG.",
   "requires": [],
   "references": [
    "M. M. Fejer, G. A. Magel, D. H. Jundt, R. L. Byer, IEEE J. Quantum Electron. 28, 2631 (1992)"
   ],
   "files": [
    "engines/qpm_shg/__init__.py",
    "engines/qpm_shg/engine.py"
   ],
   "functions": {
    "phase_matching": {
     "title": "Poling period and bandwidth",
     "equations": [
      "Δk = 4π (n_SH - n_p) / λ",
      "Λ = 2π / |Δk|",
      "Δλ_FWHM = 4 x_½ / (L |dΔk/dλ|), dΔk/dλ = -(4π/λ²)(n_g,SH - n_g,p)"
     ],
     "inputs": [
      {
       "name": "wavelength",
       "label": "Pump vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 100
      },
      {
       "name": "n_pump",
       "label": "Pump effective index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.0272,
       "min": 1
      },
      {
       "name": "n_sh",
       "label": "SH effective index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.1924,
       "min": 1
      },
      {
       "name": "ng_pump",
       "label": "Pump group index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.33,
       "min": 1
      },
      {
       "name": "ng_sh",
       "label": "SH group index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.4,
       "min": 1
      },
      {
       "name": "length",
       "label": "Poled length",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 4
      }
     ],
     "outputs": [
      {
       "name": "period",
       "label": "Poling period",
       "ui_unit": "µm",
       "scale": 1e-06
      },
      {
       "name": "delta_k",
       "label": "Phase mismatch Δk",
       "ui_unit": "1/cm",
       "scale": 100.0
      },
      {
       "name": "coherence_length",
       "label": "Coherence length",
       "ui_unit": "µm",
       "scale": 1e-06
      },
      {
       "name": "fwhm",
       "label": "QPM bandwidth (pump FWHM)",
       "ui_unit": "nm",
       "scale": 1e-09
      }
     ]
    }
   }
  },
  {
   "engine": "slab_waveguide",
   "version": 1,
   "title": "Slab waveguide modes",
   "description": "Effective index, V and b of a three-layer slab mode (multilayer stacks via multilayer_neff in Python).",
   "requires": [],
   "references": [
    "K. Okamoto, Fundamentals of Optical Waveguides, 2nd ed. (Academic Press, 2006), ch. 2"
   ],
   "files": [
    "engines/slab_waveguide/__init__.py",
    "engines/slab_waveguide/engine.py"
   ],
   "functions": {
    "slab_neff": {
     "title": "Three-layer slab mode",
     "equations": [
      "k d sqrt(n_f^2 - N^2) = m pi + atan(r_s γ_s / κ) + atan(r_c γ_c / κ)",
      "V = k d sqrt(n_f^2 - n_s^2)"
     ],
     "inputs": [
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1550,
       "min": 100
      },
      {
       "name": "n_sub",
       "label": "Substrate index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.444,
       "min": 1.0
      },
      {
       "name": "n_core",
       "label": "Core index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 2.138,
       "min": 1.0
      },
      {
       "name": "n_clad",
       "label": "Cladding index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.0,
       "min": 1.0
      },
      {
       "name": "thickness",
       "label": "Core thickness",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 600,
       "min": 1
      },
      {
       "name": "polarization",
       "label": "Polarisation",
       "type": "choice",
       "choices": [
        "TE",
        "TM"
       ],
       "default": "TE"
      },
      {
       "name": "order",
       "label": "Mode order",
       "ui_unit": "",
       "scale": 1.0,
       "default": 0,
       "min": 0,
       "step": 1
      }
     ],
     "outputs": [
      {
       "name": "neff",
       "label": "Effective index",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "V",
       "label": "Normalised frequency V",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "b",
       "label": "Normalised index b",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "n_modes",
       "label": "Guided modes of this polarisation",
       "ui_unit": "",
       "scale": 1.0
      }
     ]
    }
   }
  },
  {
   "engine": "squeezed_light",
   "version": 1,
   "title": "Squeezed light from χ⁽²⁾ (Hamiltonian)",
   "description": "Quadrature and two-mode squeezing from χ⁽²⁾ parametric processes in the Hamiltonian formalism. Quadratic momentum generator → Heisenberg drift → covariance with loss (Bogoliubov), OPO output spectra, squeezed-vacuum statistics, and exact Fock-space evolution of the full three-wave Hamiltonian with a quantum, depletable pump.",
   "requires": [],
   "references": [
    "C. M. Caves, B. L. Schumaker, Phys. Rev. A 31, 3068 (1985)",
    "M. J. Collett, C. W. Gardiner, Phys. Rev. A 30, 1386 (1984)",
    "C. W. Gardiner, P. Zoller, Quantum Noise, 3rd ed. (Springer, 2004), ch. 10",
    "C. Weedbrook et al., Rev. Mod. Phys. 84, 621 (2012)",
    "M. Hillery, M. S. Zubairy, Phys. Rev. A 29, 1275 (1984)",
    "L.-A. Wu, H. J. Kimble, J. L. Hall, H. Wu, Phys. Rev. Lett. 57, 2520 (1986)"
   ],
   "files": [
    "engines/squeezed_light/__init__.py",
    "engines/squeezed_light/engine.py"
   ],
   "functions": {
    "degenerate_squeezing": {
     "title": "Degenerate OPA (single-mode)",
     "equations": [
      "G/ħ = (Δk/2) a†a + i(γ/2)(a†² − a²) = ½ Rᵀ M R,  R = (x, p),  x = a + a†",
      "dR/dz = A R,  A = 2ΩM − (α/2) I;  dV/dz = A V + V Aᵀ + α I",
      "γ = √(η P_p),  η = 8π² d_eff² / (ε₀ c n_s² n_p λ_s² A_eff),  r = γ L",
      "lossless: V∓ = (|μ| ∓ |ν|)²,  μ = cosh gL − i(Δk/2g) sinh gL,  ν = (γ/g) sinh gL,  g = √(γ² − Δk²/4)"
     ],
     "inputs": [
      {
       "name": "pump_power",
       "label": "Pump power (peak)",
       "ui_unit": "W",
       "scale": 1.0,
       "default": 1.0,
       "min": 0
      },
      {
       "name": "length",
       "label": "Interaction length",
       "ui_unit": "mm",
       "scale": 0.001,
       "default": 5,
       "min": 0
      },
      {
       "name": "d_eff",
