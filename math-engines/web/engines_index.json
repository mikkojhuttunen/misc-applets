       "name": "geometry",
       "label": "Geometry",
       "type": "choice",
       "choices": [
        "strip",
        "rib",
        "ridge",
        "buried"
       ],
       "default": "strip"
      },
      {
       "name": "width",
       "label": "Strip / rib / core width w",
       "ui_unit": "µm",
       "scale": 1e-06,
       "default": 2.0,
       "min": 0.05
      },
      {
       "name": "film_thickness",
       "label": "Film or core thickness t",
       "ui_unit": "µm",
       "scale": 1e-06,
       "default": 0.4,
       "min": 0.01
      },
      {
       "name": "n_sup",
       "label": "Superstrate index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.444,
       "min": 1.0
      },
      {
       "name": "n_film",
       "label": "Film / core index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.65,
       "min": 1.0
      },
      {
       "name": "n_sub",
       "label": "Substrate index",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.444,
       "min": 1.0
      },
      {
       "name": "wavelength",
       "label": "Vacuum wavelength",
       "ui_unit": "nm",
       "scale": 1e-09,
       "default": 1532,
       "min": 200
      },
      {
       "name": "polarization",
       "label": "Polarisation family",
       "type": "choice",
       "choices": [
        "TE",
        "TM"
       ],
       "default": "TE"
      },
      {
       "name": "strip_height",
       "label": "Strip height h (strip-loaded)",
       "ui_unit": "µm",
       "scale": 1e-06,
       "default": 0.4,
       "min": 0
      },
      {
       "name": "n_strip",
       "label": "Strip index (strip-loaded)",
       "ui_unit": "",
       "scale": 1.0,
       "default": 1.65,
       "min": 1.0
      },
      {
       "name": "slab_thickness",
       "label": "Slab beside the rib (rib)",
       "ui_unit": "µm",
       "scale": 1e-06,
       "default": 0.0,
       "min": 0
      },
      {
       "name": "depth",
       "label": "Core top to surface (buried)",
       "ui_unit": "µm",
       "scale": 1e-06,
       "default": 0.0,
       "min": 0
      }
     ],
     "outputs": [
      {
       "name": "neff",
       "label": "Effective indices (descending)",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "n_modes",
       "label": "Guided modes of this family",
       "ui_unit": "",
       "scale": 1.0
      },
      {
       "name": "outside_slab_neff",
       "label": "Outside slab fundamental",
       "ui_unit": "",
       "scale": 1.0
      }
     ]
    },
    "fd_fundamental": {
     "title": "Fundamental mode, semi-vectorial finite differences",
     "equations": [
      "quasi-TE: ∂x[(1/n²)∂x(n² E_x)] + ∂y² E_x + k0² n² E_x = β² E_x",
      "share_r = ∫_r |E|² dA / ∫|E|² dA"
     ],
     "inputs": [
      {
       "name": "geometry",
