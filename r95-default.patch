+"""Task 14 milestone check vs R (run from QUIET_sims_v32/): 10 mm-style limits at 0.1 / 1 / 15 s, 1 and 10 mW, insertion loss incl. 8 dB couplers, time to CH4 10 ppb and C2H6 2 ppb at 1 mW. Model of scripts/t14_analysis.py (all dithers, referenced, synchronous)."""
+import json,math,sys,numpy as np
+sys.path.insert(0,".")
+sys.argv=['x']; src=open('scripts/t14_analysis.py').read().split('summary, L =')[0]
+__file__="scripts/t14_analysis.py"; src=src.replace("Path(__file__).resolve().parent.parent","Path(\".\").resolve()"); exec(src)
+def lim(rows,T,P,gas,ln,sm,band='mir'):
+    lam=BAND[band][0]; a=LN[ln]["alpha_peak_per_ppm_cm"]; v=[]
+    for x in rows:
+        d=x.get("d",{}).get("w75 A60 X100")
+        if not d: continue
+        k=1e3/(a*d["GL_cm"]*sm)
+        v.append(k*math.hypot(residual(d["fringe"],"both+global 0.0001",T,0.1,TAU,True),det(T,P*d["T"]*10**-0.8,lam,14e-12)))
+    return float(np.median(v))
+for R in (0.95,0.97,0.995):
+    d=json.load(open(f"results/t14/mir_R{R}.json"))
+    for c in ("d5","d10","d20"):
+        rows=d["cells"][c]["chaotic"]
+        Tm=med(rows,"w75 A60 X100",lambda x:x["T"])
+        il=-10*math.log10(Tm)+8
+        s=[]
+        for P in (1e-3,10e-3):
+            for T in (0.1,1,15):
+                s.append(f"{lim(rows,T,P,'CH4','CH4_3.31',0.921):.2g}/{lim(rows,T,P,'C2H6','C2H6_3.34Q',0.824):.2g}")
+        # time for ethane 2 ppb at 1 mW
+        Ts=np.logspace(-2,2,400); t2=next((t for t in Ts if lim(rows,t,1e-3,'C2H6','C2H6_3.34Q',0.824)<=2),None)
+        t10=next((t for t in Ts if lim(rows,t,1e-3,'CH4','CH4_3.31',0.921)<=10),None)
+        print(R,c,f"IL {il:.1f} dB",s,f"t(CH4 10ppb,1mW)={t10:.2g}s" if t10 else "", f"t(C2H6 2ppb,1mW)={t2:.2g}s" if t2 else "none")
