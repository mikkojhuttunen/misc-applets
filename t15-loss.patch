+"""Task 15: effect of the membrane (slab-mode) propagation loss, 0.1-3 dB/cm, at R 95 % and 3.3 um.
+
+Runs (R 95 %, set B at 3.3 um, the Task 14 design: grating input 75 um waist +-60 mrad +-100 um, wavelength dither +-81 pm,
+whole-membrane delta n_eff 1e-4, 30 layouts):
+  node scripts/ensemble.js --cell circle --wavelength 3.3151e-6 --n_eff 1.4253 --gamma 0.5526 --R 0.95 --dBcm <dB> --seeds 30 --stat --paths --out results/t2/circle_mir_R0.95_<dB>dB.json
+  node scripts/t10_design.js --band mir --R 0.95 --dBcm <dB> --variants base --seeds 30 --out /dev/null   (prints c_cal; results/t15/c_cal.txt)
+  node scripts/t14_waist_mod.js --band mir --R 0.95 --dBcm <dB> --c_cal <c> --out results/t15/mir_R0.95_<dB>dB.json
+  node scripts/t14_herriott.js  --band mir --R 0.95 --dBcm <dB> --c_cal <c> --out results/t15/herriott_mir_R0.95_<dB>dB.json
+python scripts/t15_loss.py -> results/t15/summary.json, results/t15/table.md
+Limits: scripts/t14_milestones.py (period-locked averaging, breath referencing every 3 s, drift 0.1 rad/s, NEP 14 pW/rtHz,
+simulated transmission + 8 dB couplers), median over the chaotic layouts, design beam, all dithers.
+"""
+import json, math, sys
+from pathlib import Path
+import numpy as np
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import t14_milestones as M  # noqa: E402
+ROOT = Path(__file__).resolve().parent.parent
+OUT = ROOT / "results/t15"
+DBS = [l.split() for l in open(OUT / "c_cal.txt").read().split("\n") if l.strip()]
+BM, KEY = M.BM, M.KEY
+med = lambda rows, f: float(np.median([f(x["d"][BM]) for x in rows]))
+S, L = {}, ["# Task 15: membrane propagation loss (generated by scripts/t15_loss.py)", "",
+            "R 95 %, 3.3 µm, set B (n_eff 1.425, Γ 0.553), Task 14 design, all dithers; medians over 30 chaotic layouts. 100 ms limits CH₄ / C₂H₆ in ppb,",
+            "referenced every 3 s, period-locked averaging, NEP 14 pW/√Hz, simulated transmission + 8 dB couplers. IL = insertion loss incl. couplers.", "",
+            "| dB/cm | c_cal | cell | T | IL dB | Γ⟨L⟩ cm | ⟨L⟩ cm | fringe, all | fringe-only 0.1 s | 1 mW | 10 mW | 30 mW | 1 s, 1 mW | CH₄ 10 ppb, 1 mW |",
+            "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|"]
+for dB, c in DBS:
+    d = json.load(open(OUT / f"mir_R0.95_{dB}dB.json"))
+    for cell in ("d5", "d10", "d15", "d20"):
+        rows = [x for x in d["cells"][cell]["chaotic"] if x.get("d", {}).get(BM)]
+        T = med(rows, lambda x: x["T"]); GL = med(rows, lambda x: x["GL_cm"])
+        e = {"c_cal": float(c), "T": T, "IL_dB": -10 * math.log10(T) + 8, "GL_cm": GL, "L_cm": GL / 0.5526, "fringe_all": med(rows, lambda x: x["fringe"][KEY]),
+             "fringe_none": med(rows, lambda x: x["fringe"]["none"]), "fringe_no_dn": med(rows, lambda x: x["fringe"]["both"]),
+             "fringe_only_0.1s": {g: M.lim(rows, 0.1, 1, g, fringe_only=True) for g in M.GAS},
+             "lim_0.1s": {f"{P * 1e3:g}mW": {g: M.lim(rows, 0.1, P, g) for g in M.GAS} for P in (1e-3, 10e-3, 30e-3, 50e-3)},
+             "lim_1s_1mW": {g: M.lim(rows, 1, 1e-3, g) for g in M.GAS}, "t_CH4_10ppb_1mW_s": M.t_for(rows, 1e-3, "CH4", 10)}
+        S[f"{dB}|{cell}"] = e
+        l = e["lim_0.1s"]; f2 = lambda q: f"{q['CH4']:.3g} / {q['C2H6']:.3g}"
+        t = e["t_CH4_10ppb_1mW_s"]
+        L.append(f"| {dB} | {float(c):.3f} | {cell[1:]} mm | {T * 100:.2g} % | {e['IL_dB']:.1f} | {GL:.1f} | {e['L_cm']:.1f} | {e['fringe_all']:.2g} | {f2(e['fringe_only_0.1s'])} | "
+                 f"{f2(l['1mW'])} | {f2(l['10mW'])} | {f2(l['30mW'])} | {f2(e['lim_1s_1mW'])} | {'%.2g s' % t if t else '> 100 s'} |")
+L += ["", "Herriott of the same length (1.5 mm wide, same input, dithers and modulation), 10 mm:", "", "| dB/cm | T | Γ⟨L⟩ cm | fringe, all |", "|---|---|---|---|"]
+for dB, c in DBS:
+    h = json.load(open(OUT / f"herriott_mir_R0.95_{dB}dB.json"))["cells"]["h10"]
+    rows = [x for x in h["chaotic"] if x.get("d", {}).get(BM)]
+    e = {"T": med(rows, lambda x: x["T"]), "GL_cm": med(rows, lambda x: x["GL_cm"]), "fringe_all": med(rows, lambda x: x["fringe"][KEY])}
+    S[f"{dB}|herriott_d10"] = e
+    L.append(f"| {dB} | {e['T'] * 100:.2g} % | {e['GL_cm']:.2f} | {e['fringe_all']:.2g} |")
+json.dump(S, open(OUT / "summary.json", "w"), indent=1)
+open(OUT / "table.md", "w").write("\n".join(L) + "\n")
+print("\n".join(L))
