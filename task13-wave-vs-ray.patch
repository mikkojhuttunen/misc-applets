+  res = { runs: [] };
+  for (const sigma of [7e-6, 10e-6, 14e-6]) res.runs.push(run([C(40e-6, 2e-3, 0), C(75e-6, 60e-3, 0), C(75e-6, 0, 100e-6), C(75e-6, 60e-3, 100e-6)], { sigma }));
