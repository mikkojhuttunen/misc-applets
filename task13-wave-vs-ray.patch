+/* Task 13: why the input (angle, position) dither gains less in the wave-consistent model than in the ray model.
+
+   node scripts/t13_wave_vs_ray.js --sweep ray_vs_wave|amplitude|lambda|regular --out results/t13/<name>.json [--seeds 10]
+
+   Same Gaussian-beamlet model as Task 9 (scripts/t9_input_states.js): the input field is expanded on a Gabor lattice of
+   beamlets, each traced as one engine ray to the output port (exit phasor g_j); the static fringe of an input dither is
+   F = sum_j cbar_j g_j with cbar_j the dither-averaged overlap. Added here, on the same layouts:
+   - the ray model's factor: the engine's V_theta (DitherLab.analyse, one zero-width centre ray per dither angle, phase
+     resolved adaptively), for the angle-only dithers;
+   - the number of input states swept, N = sum |c_j(0)|^2 / sum |cbar_j|^2, and N^(-1/2);
+   - sine (dwells at the turning points) and triangle (uniform) dither waveforms;
+   - a scaled wavelength (the geometric-optics limit, lambda -> 0, at fixed geometry and dither).
+   Circle cell, set B (500 nm SiNx, 1.53 um: n_eff 1.539), R 97 %, 0.3 dB/cm, input dither only (no wavelength dither):
+   the factors are the input-dither fringe factors, layout by layout (rms over the chaotic layouts). */
+const fs = require('fs');
+const path = require('path');
+const { loadEngine } = require('./engine_path.js');
+const { config, args } = require('./cells.js');
+const { DitherLab: D, GasEngine: G, PlanarEngine: Pl } = loadEngine();
+const a = args(process.argv.slice(2));
+const sweep = a.sweep || 'ray_vs_wave', nSeed = +(a.seeds || 10), R = 0.97, dBcm = 0.3, XMAX = 250e-6;
+const NIR = { lam: 1.5317e-6, n: 1.5391, gamma: 0.4532 };
+
+const wave = (n, form) => Array.from({ length: n }, (_, i) => { const t = (i + 0.5) / n; return form === 'tri' ? 1 - 4 * Math.abs(t - 0.5) : Math.sin(2 * Math.PI * t); });
+
+/* one configuration: waist w, angle amplitude A (rad), position amplitude X (m), waveform, wavelength scale s (lambda = s lambda_NIR) */
+function lattice(confs, lam, sigma) {
+  const kap = 2 * Math.PI / lam * NIR.n, r = Math.sqrt(Math.PI), dx = r * sigma, dphi = r / (2 * kap * sigma);
+  const PHIMAX = Math.max(...confs.map(c => c.A)) + 3 / (kap * Math.min(...confs.map(c => c.w))) + 3 / (2 * kap * sigma);
+  const xs = [], phis = [];
+  for (let x = -XMAX; x <= XMAX + 1e-12; x += dx) xs.push(x);
+  for (let p = -Math.ceil(PHIMAX / dphi) * dphi; p <= PHIMAX + 1e-12; p += dphi) phis.push(p);
+  return { kap, xs, phis, sigma };
+}
+function coef(L, xj, pj, w, X, Th) {
+  const s = L.sigma, A = 1 / (4 * s * s) + 1 / (w * w);
+  const Br = xj / (2 * s * s) + 2 * X / (w * w), Bi = L.kap * (Th - pj);
+  const Cr = xj * xj / (4 * s * s) + X * X / (w * w), Ci = L.kap * Th * X;
+  const er = (Br * Br - Bi * Bi) / (4 * A) - Cr, ei = (2 * Br * Bi) / (4 * A) - Ci, m = Math.sqrt(Math.PI / A) * Math.exp(er);
+  return [m * Math.cos(ei), m * Math.sin(ei)];
+}
+/* dither samples: tilt step <= half the beam divergence, shift step <= w / 2 (as Task 9b), at least 48 per period */
+function samples(c, kap) {
+  const nA = c.A > 0 ? Math.max(48, Math.ceil(2 * Math.PI * c.A * kap * c.w)) : 1, nX = c.X > 0 ? Math.max(48, Math.ceil(4 * Math.PI * c.X / c.w)) : 1;
