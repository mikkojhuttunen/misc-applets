+function exitPhasor(S, o, k0, x, th, nB) {
+  const c = S.mc.cell, cosT = Math.max(Math.cos(S.theta), 1e-6);
+  const rr = G.marchRay(S.mc, Pl.launch(c, c.sIn + x / cosT, th), nB, c.sIn, c.sOut, c.meta.portW, 'out');
+  if (rr.exit !== 1) return null;
+  const h = rr.nWalls, Lp = rr.WL[h - 1], amp = Math.pow(o.R_mirror, (h - 1) / 2) * Math.exp(-0.5 * o.alpha_m * rr.WG[h - 1]);
+  return { amp, ph: k0 * S.mc.n0 * Lp };
+}
+function layoutOpts(seed, lam) {
+  const base = config('circle', { n_eff: NIR.n, R, dBcm, wavelength: lam, gamma: NIR.gamma });
+  return Object.assign({}, D.DEFAULTS, seed === null ? D.regular(Object.assign({}, base, { inc_seed: 1 })) : Object.assign({}, base, { inc_seed: seed }));
+}
+/* input-dither factor of every configuration on one layout: wave (beamlets) and ray (centre ray per dither sample) */
+function runLayout(seed, confs, lam, sigma, Ls, Cs) {
+  const o = layoutOpts(seed, lam), S = D.setup(o), k0 = 2 * Math.PI / lam;
+  G.setAlpha(o.alpha_m); G.setRTable(null);
+  const nB = Math.min(3000, Math.ceil(Math.log(1e-4) / Math.log(Math.min(o.R_mirror, 0.99999))));
+  const L = Ls, g = [];
+  for (const xj of L.xs) for (const pj of L.phis) g.push(exitPhasor(S, o, k0, xj, S.theta + pj, nB));
+  const out = {};
+  for (const c of confs) {
+    const K = Cs[c.name];
+    let F0r = 0, F0i = 0, n0 = 0, Fr = 0, Fi = 0;
+    for (let j = 0; j < g.length; j++) {
+      const gj = g[j]; if (!gj) continue;
+      const gr = gj.amp * Math.cos(gj.ph), gi = gj.amp * Math.sin(gj.ph), c0 = K.c0[j], cb = K.cb[j];
+      n0 += (c0[0] * c0[0] + c0[1] * c0[1]) * gj.amp * gj.amp;
+      F0r += c0[0] * gr - c0[1] * gi; F0i += c0[0] * gi + c0[1] * gr;
+      Fr += cb[0] * gr - cb[1] * gi; Fi += cb[0] * gi + cb[1] * gr;
+    }
+    /* ray model: the engine's own angle-dither factor V_theta for this layout (angle-only dithers) */
+    let ray = null, ray_floor = null;
+    if (c.A > 0 && c.X === 0 && !a.noray) {
+      const r = D.analyse(Object.assign({}, o, { dither: c.A, waveform: c.form === 'tri' ? 'triangle' : 'sine', n_samp: 4096, n_u: 12, n_v: 32, n_side: 8 }), { full: false });
+      ray = r.V_theta; ray_floor = r.V_floor;
+    }
+    out[c.name] = { wave: Math.hypot(Fr, Fi) / Math.sqrt(n0), wave_none: Math.hypot(F0r, F0i) / Math.sqrt(n0), ray, ray_floor, exit: g.filter(Boolean).length / g.length };
+  }
+  return out;
+}
+function run(confs, { lam = NIR.lam, sigma = 10e-6, seeds = nSeed, regular = true } = {}) {
+  const L = lattice(confs, lam, sigma), Cs = {};
+  for (const c of confs) Cs[c.name] = coefficients(L, c);
+  const rows = [], t0 = Date.now();
+  const list = (regular ? [null] : []).concat(Array.from({ length: seeds }, (_, i) => i + 1));
+  for (const s of list) rows.push({ layout: s === null ? 'regular' : `seed${s}`, f: runLayout(s, confs, lam, sigma, L, Cs) });
+  const rms = v => Math.sqrt(v.reduce((x, y) => x + y * y, 0) / v.length), med = v => { const b = [...v].sort((x, y) => x - y); return b[Math.floor(b.length / 2)]; };
+  const sum = confs.map(c => {
+    const ch = rows.filter(r => r.layout !== 'regular').map(r => r.f[c.name]), rg = rows.find(r => r.layout === 'regular');
+    return { name: c.name, w: c.w, A: c.A, X: c.X, form: c.form, lam, N: Cs[c.name].N, Nm05: 1 / Math.sqrt(Cs[c.name].N), nA: Cs[c.name].sA.length, nX: Cs[c.name].sX.length,
+      wave_rms: rms(ch.map(f => f.wave)) / rms(ch.map(f => f.wave_none)), ray_rms: ch[0].ray === null ? null : rms(ch.map(f => f.ray)),
+      ray_floor: ch[0].ray === null ? null : med(ch.map(f => f.ray_floor)),
+      wave_regular: rg ? rg.f[c.name].wave : null, wave_none_regular: rg ? rg.f[c.name].wave_none : null, ray_regular: rg ? rg.f[c.name].ray : null, exit_frac: med(ch.map(f => f.exit)) };
+  });
+  console.error(`  lam ${(lam * 1e6).toFixed(3)} um, lattice ${L.xs.length} x ${L.phis.length}, ${confs.length} confs, ${list.length} layouts, ${((Date.now() - t0) / 1000).toFixed(0)} s`);
+  return { lattice: { nx: L.xs.length, nphi: L.phis.length, sigma }, summary: sum, rows };
+}
+
+const C = (w, A, X, form = 'sine') => ({ name: `w${Math.round(w * 1e6)} A${+(A * 1e3).toFixed(1)} X${Math.round(X * 1e6)} ${form}`, w, A, X, form });
+let res;
+if (sweep === 'ray_vs_wave') {
+  const confs = [];
+  for (const w of [40e-6, 75e-6, 150e-6]) for (const A of [1e-3, 2e-3, 5e-3, 10e-3, 20e-3, 40e-3, 60e-3]) confs.push(C(w, A, 0));
+  res = run(confs);
+} else if (sweep === 'amplitude') {
+  const confs = [];
+  for (const form of ['sine', 'tri']) {
+    for (const A of [15e-3, 30e-3, 60e-3, 100e-3, 150e-3, 200e-3]) confs.push(C(75e-6, A, 0, form));
+    for (const X of [25e-6, 50e-6, 100e-6, 150e-6, 200e-6]) confs.push(C(75e-6, 0, X, form));
+    for (const [A, X] of [[30e-3, 100e-6], [60e-3, 100e-6], [100e-3, 100e-6], [60e-3, 150e-6], [100e-3, 150e-6]]) confs.push(C(75e-6, A, X, form));
+  }
+  res = run(confs);
