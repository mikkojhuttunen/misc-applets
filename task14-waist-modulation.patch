@@ -0,0 +1,40 @@
+"""Task 14 outlook: 100 ms CH4 / C2H6 limits of the best designs against the averaging of the dithers and the laser power.
+
+AC remainder of the input / wavelength dithers: boxcar at 1 kHz (Task 12), boxcar at 10 kHz, or synchronous averaging over
+whole dither periods (removed). Referenced every 3 s, drift 0.1 rad/s, NEP 14 pW/rtHz, two grating couplers (8 dB)."""
+import json, math, sys
+from pathlib import Path
+import numpy as np
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import t14_analysis as T   # noqa: E402
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def lim(rows, bm, key, ln, sm, fac, P, NEP=14e-12, w=0.1, tau=3.0, Tm=0.1):
+    a = T.LN[ln]["alpha_peak_per_ppm_cm"]; v = []
+    for x in rows:
+        s = x["d"][bm]; F = s["fringe"]; k = 1e3 / (a * s["GL_cm"] * sm)
+        st = F[key] * T.Hd(Tm, w)
+        ac = 0 if fac is None else math.sqrt(max(F["none"] ** 2 - F["both"] ** 2, 0)) * T.Hac(Tm, fac)
+        f = math.hypot(st, ac) * (2 * math.sin(w * tau / 2) if tau else 1)
+        v.append(k * math.hypot(f, T.det(Tm, P * s["T"] * 10 ** -0.8, 3.3151e-6, NEP)))
+    return float(np.median(v))
+
+
+L = ["", "## Outlook: 100 ms CH4 / C2H6 (ppb, 1σ, median), referenced, drift 0.1 rad/s, NEP 14 pW/√Hz", "",
+     "| R | cell | dither | 1 kHz boxcar, 10 mW | 10 kHz boxcar, 10 mW | synchronous, 1 mW | synchronous, 10 mW | synchronous, 50 mW |", "|---|---|---|---|---|---|---|---|"]
+out = {}
+for R in (0.97, 0.995):
+    d = json.load(open(ROOT / f"results/t14/mir_R{R}.json"))
+    for c in T.CELLS:
+        rows = [x for x in d["cells"][c]["chaotic"] if x.get("d", {}).get("w75 A60 X100")]
+        for key in ("both", "both+global 0.0001"):
+            cells = []
+            for fac, P in ((1000, 10e-3), (1e4, 10e-3), (None, 1e-3), (None, 10e-3), (None, 50e-3)):
+                cells.append(tuple(lim(rows, "w75 A60 X100", key, ln, sm, fac, P) for g, ln, sm in T.GASES["mir"]))
+            out[f"R{R}|{c}|{key}"] = cells
+            L.append(f"| {R * 100:g} % | {c[1:]} mm | {'input + λ' if key == 'both' else 'input + λ + membrane δ 1e-4'} | " + " | ".join(f"{a:.2f} / {b:.2f}" for a, b in cells) + " |")
+json.dump(out, open(ROOT / "results/t14/outlook.json", "w"), indent=1)
+open(ROOT / "results/t14/table.md", "a").write("\n".join(L) + "\n")
+print("\n".join(L))
