@@ -0,0 +1,40 @@
+"""Task 14 compact table: 100 ms CH4 / C2H6 limits with the fringe and detector parts, per cell, R, beam and modulation."""
+import json, math, sys
+from pathlib import Path
+import numpy as np
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import t14_analysis as T   # noqa: E402  (re-runs the analysis tables; cheap)
+
+ROOT = Path(__file__).resolve().parent.parent
+rows_out, L = {}, ["", "## Compact: 100 ms, referenced (3 s), drift 0.1 rad/s, synchronous modulation; CH4 / C2H6 ppb (fringe part, detector part)", ""]
+for R in (0.97, 0.995):
+    d = json.load(open(ROOT / f"results/t14/mir_R{R}.json"))
+    L += [f"### R {R * 100:g} %", "", "| cell | beam | dither | fringe | CH4 total | CH4 fringe / det | C2H6 total | det at 20 / 50 mW, CH4 | 1 nW/√Hz, CH4 / C2H6 |", "|---|---|---|---|---|---|---|---|---|"]
+    for c in T.CELLS:
+        C = d["cells"][c]
+        for bm in ("w75 A60 X100", max(C["N"], key=lambda b: C["N"][b])):
+            for key in ("both", "both+zone 0.0001", "both+global 0.0001", "both+global 0.001"):
+                rows = [x for x in C["chaotic"] if x.get("d", {}).get(bm)]
+                out = {}
+                for g, ln, sm in T.GASES["mir"]:
+                    a = T.LN[ln]["alpha_peak_per_ppm_cm"]
+                    def part(NEP, P, which):
+                        v = []
+                        for x in rows:
+                            s = x["d"][bm]; k = 1e3 / (a * s["GL_cm"] * sm)
+                            f = T.residual(s["fringe"], key, 0.1, 0.1, 3.0, True); e = T.det(0.1, P * s["T"] * 10 ** -0.8, 3.3151e-6, NEP)
+                            v.append(k * {"tot": math.hypot(f, e), "f": f, "d": e}[which])
+                        return float(np.median(v))
+                    out[g] = {"tot": part(14e-12, 10e-3, "tot"), "f": part(14e-12, 10e-3, "f"), "d": part(14e-12, 10e-3, "d"),
+                              "d20": part(14e-12, 20e-3, "d"), "d50": part(14e-12, 50e-3, "d"), "nW": part(1e-9, 10e-3, "tot")}
+                fr = float(np.median([x["d"][bm]["fringe"][key] for x in rows]))
+                rows_out[f"R{R}|{c}|{bm}|{key}"] = dict(out, fringe=fr)
+                L.append(f"| {c[1:]} mm | {bm} | {key.replace('both+', 'both + ')} | {fr:.1e} | {out['CH4']['tot']:.2f} | {out['CH4']['f']:.2f} / {out['CH4']['d']:.2f} | {out['C2H6']['tot']:.2f} | {out['CH4']['d20']:.2f} / {out['CH4']['d50']:.2f} | {out['CH4']['nW']:.1f} / {out['C2H6']['nW']:.1f} |")
+                if bm == max(C["N"], key=lambda b: C["N"][b]) and bm == "w75 A60 X100":
+                    pass
+            if len(C["N"]) == 1:
+                break
+    L.append("")
+json.dump(rows_out, open(ROOT / "results/t14/compact.json", "w"), indent=1)
+open(ROOT / "results/t14/table.md", "a").write("\n".join(L) + "\n")
+print("\n".join(L))
