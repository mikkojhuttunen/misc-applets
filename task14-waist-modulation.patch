index 0000000..685eca2
--- /dev/null
+++ b/QUIET_sims_v32/scripts/t14_analysis.py
@@ -0,0 +1,142 @@
+"""Task 14: 100 ms limits for larger input waists and intracavity (thermo-optic) modulation.
+
+python scripts/t14_analysis.py      -> results/t14/summary.json, results/t14/table.md
+
+Limits as Task 12 (scripts/t12_fast.py): noise-equivalent fractional power hypot(fringe residual, detector) /
+(alpha_peak Gamma<L> smear), 1 sigma, median over the 30 layouts; 10 mW, two grating couplers (8 dB), NEP 14 pW/rtHz
+(and 1 nW/rtHz in the mid-IR); fringe drift 0.1 / 0.02 rad/s; breath referencing every 3 s ("ref") or none ("raw").
+Fringe residual at T: static part x drift envelope, plus the parts the boxcar average leaves of the modulated fringe:
+the >= 1 kHz input and wavelength dithers (Task 12) and, for the thermo-optic modulation, its own frequency f_mod
+(50 Hz: a heated membrane follows at ~25 Hz through its 0.3 mm gas gaps; "sync" = averaging over whole modulation
+periods, which removes that part).
+Thermo-optic swing: dn_eff/dT = (1 - Gamma) x 2.5e-5 /K for the SiNx share of the slab mode (1.1e-5 /K at 3.3 um,
+1.4e-5 /K at 1.53 um); the dn_eff amplitude delta needs Delta T = delta / (dn_eff/dT).
+"""
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+from qv import analysis as A  # noqa: E402
+
+OUT = ROOT / "results/t14"
+LN = A.load(ROOT / "results/t7/lines.json")
+BAND = {"nir": (1.5317e-6, 0.4532), "mir": (3.3151e-6, 0.5526)}
+GASES = {"nir": [("NH3", "NH3_1.53", 0.804)], "mir": [("CH4", "CH4_3.31", 0.921), ("C2H6", "C2H6_3.34Q", 0.824)]}
+T_MEAS, F_MOD, TAU = 0.1, 50.0, 3.0
+CELLS = ("d5", "d10", "d15", "d20")
+
+
+def Hd(T, w):
+    return 1 / math.sqrt(1 + 2 * (w / 2 * T) ** 2)
+
+
+def Hac(T, f):
+    return 1 / math.sqrt(1 + 2 * (math.pi * f * T) ** 2)
+
+
+def det(T, Pd, lam, NEP):
+    return math.sqrt(NEP ** 2 + 2 * 6.626e-34 * 2.998e8 / lam * Pd) / (Pd * math.sqrt(2 * T))
+
+
+def residual(F, key, T, w, tau, sync):
+    """fringe residual of a dither variant: static (drift envelope) + boxcar remainders of the kHz dithers and of f_mod"""
+    s, n0, b = F[key], F["none"], F["both"]
+    r2 = (s * Hd(T, w)) ** 2 + max(n0 ** 2 - b ** 2, 0) * Hac(T, 1000) ** 2
+    if key != "both" and not sync:
+        r2 += max(b ** 2 - s ** 2, 0) * Hac(T, F_MOD) ** 2
+    return math.sqrt(r2) * (2 * math.sin(w * tau / 2) if tau else 1)
+
+
+def limits(rows, beam, key, band, gas, ln, sm, w, tau, sync, NEP=14e-12, P=10e-3):
+    lam = BAND[band][0]
+    a = LN[ln]["alpha_peak_per_ppm_cm"]
+    v = []
+    for x in rows:
+        d = x.get("d", {}).get(beam)
+        if not d:
+            continue
+        k = 1e3 / (a * d["GL_cm"] * sm)
+        v.append(k * math.hypot(residual(d["fringe"], key, T_MEAS, w, tau, sync), det(T_MEAS, P * d["T"] * 10 ** -0.8, lam, NEP)))
+    return [float(np.quantile(v, q)) for q in (.25, .5, .75)] if v else None
+
+
+def jsnum(x):
+    """a number as JavaScript prints it (the keys of the run files): 0.00001, 0.0003, 0.001"""
+    return f"{x:.12f}".rstrip("0").rstrip(".")
+
+
+def med(rows, beam, f):
+    v = [f(x["d"][beam]) for x in rows if x.get("d", {}).get(beam)]
+    return float(np.median(v)) if v else None
+
+
+summary, L = {}, ["# Task 14: larger input waists and intracavity modulation (generated by scripts/t14_analysis.py)", "",
+                  "100 ms limits in ppb (1σ, median over 30 layouts), referenced every 3 s, drift 0.1 rad/s, 10 mW, NEP 14 pW/√Hz unless noted;",
+                  "fringe residual = 2√ε V/√M, ε = 1e-6, static, median. Thermo-optic modulation at 50 Hz (boxcar) or synchronous (whole periods).", ""]
+for band, Rs in (("mir", (0.97, 0.995)), ("nir", (0.97,))):
+    dndT = (1 - BAND[band][1]) * 2.5e-5
+    for R in Rs:
+        f = OUT / f"{band}_R{R}.json"
+        if not f.exists():
+            continue
+        d = json.load(open(f))
+        tag = f"{band} R {R * 100:g} %"
+        # 1. waist
+        L += [f"## {tag}: input waist (both dithers: input + wavelength {d['dlam'] * 1e12:.0f} pm)", "",
+              "| cell | beam | N | T | Γ⟨L⟩ cm | M | fringe, both | " + " | ".join(f"{g} 0.1 s" for g, _, _ in GASES[band]) + " |",
+              "|---|---|---|---|---|---|---|" + "---|" * len(GASES[band])]
+        for c in CELLS:
+            C = d["cells"][c]
+            for bm in C["N"]:
+                rows = C["chaotic"]
+                lims = [limits(rows, bm, "both", band, g, ln, sm, 0.1, TAU, True) for g, ln, sm in GASES[band]]
+                summary[f"{band}|R{R}|{c}|{bm}|both"] = {"N": C["N"][bm], "T": med(rows, bm, lambda x: x["T"]), "GL_cm": med(rows, bm, lambda x: x["GL_cm"]),
+                                                       "M": med(rows, bm, lambda x: x["M"]), "fringe": med(rows, bm, lambda x: x["fringe"]["both"]),
+                                                       "lim": {g: l for (g, _, _), l in zip(GASES[band], lims)}}
+                s = summary[f"{band}|R{R}|{c}|{bm}|both"]
+                L.append(f"| {c[1:]} mm | {bm} | {s['N']:.0f} | {s['T']:.3f} | {s['GL_cm']:.1f} | {s['M']:.0f} | {s['fringe']:.1e} | " + " | ".join(f"{l[1]:.3g}" for l in lims) + " |")
+        L.append("")
+        # 2. modulation, on the Task 11 design beam and on the best beam of each cell
+        L += [f"## {tag}: intracavity thermo-optic modulation (amplitude δ of n_eff; ΔT = δ / {dndT:.2g} K⁻¹)", "",
+              "| cell | beam | modulation | δ | ΔT (K) | fringe, both + mod | " + " | ".join(f"{g} 0.1 s, sync / 50 Hz" for g, _, _ in GASES[band]) + " | fringe, wavelength + mod (no input dither) |",
+              "|---|---|---|---|---|---|" + "---|" * len(GASES[band]) + "---|"]
+        for c in CELLS:
+            C = d["cells"][c]
+            beams = ["w75 A60 X100"] + ([max(C["N"], key=lambda b: C["N"][b])] if len(C["N"]) > 1 else [])
+            for bm in beams:
+                rows = C["chaotic"]
+                for mod in ("indep", "common", "zone", "global"):
+                    for dl in d["deltas"]:
+                        for spot in ((" spot25", " spot75") if mod in ("indep", "common") else ("",)):
+                            key = f"both+{mod} {jsnum(dl)}{spot}"
+                            fr = med(rows, bm, lambda x: x["fringe"][key])
+                            fs = med(rows, bm, lambda x: x["fringe"][key.replace("both+", "spectral+")])
+                            ls = [limits(rows, bm, key, band, g, ln, sm, 0.1, TAU, True) for g, ln, sm in GASES[band]]
+                            la = [limits(rows, bm, key, band, g, ln, sm, 0.1, TAU, False) for g, ln, sm in GASES[band]]
+                            summary[f"{band}|R{R}|{c}|{bm}|{key}"] = {"fringe": fr, "fringe_no_input": fs, "dT_K": dl / dndT,
+                                                                    "lim_sync": {g: l for (g, _, _), l in zip(GASES[band], ls)},
+                                                                    "lim_50Hz": {g: l for (g, _, _), l in zip(GASES[band], la)}}
+                            if mod in ("indep", "common") and spot == " spot25" and dl not in (1e-3, 3e-3):
+                                continue        # the table keeps the informative rows; summary.json has all
+                            L.append(f"| {c[1:]} mm | {bm} | {mod}{spot} | {dl:g} | {dl / dndT:.2g} | {fr:.1e} | " +
+                                     " | ".join(f"{s_[1]:.3g} / {a_[1]:.3g}" for s_, a_ in zip(ls, la)) + f" | {fs:.1e} |")
+        L.append("")
+        # 3. detector check for the mid-IR: uncooled 1 nW/rtHz with the best variant
+        if band == "mir":
+            L += [f"## {tag}: with a 1 nW/√Hz detector (global δ 1e-4, synchronous, best beam)", "", "| cell | beam | " + " | ".join(f"{g} 0.1 s" for g, _, _ in GASES[band]) + " |", "|---|---|" + "---|" * len(GASES[band])]
+            for c in CELLS:
+                C = d["cells"][c]
+                bm = max(C["N"], key=lambda b: C["N"][b])
+                key = "both+global 0.0001"
+                ls = [limits(C["chaotic"], bm, key, band, g, ln, sm, 0.1, TAU, True, NEP=1e-9) for g, ln, sm in GASES[band]]
+                summary[f"{band}|R{R}|{c}|{bm}|{key}|NEP1nW"] = {g: l for (g, _, _), l in zip(GASES[band], ls)}
+                L.append(f"| {c[1:]} mm | {bm} | " + " | ".join(f"{l[1]:.3g}" for l in ls) + " |")
+            L.append("")
+json.dump(summary, open(OUT / "summary.json", "w"), indent=1)
+open(OUT / "table.md", "w").write("\n".join(L) + "\n")
+print("\n".join(L))
